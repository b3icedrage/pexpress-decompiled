<?xml version="1.0" encoding="utf-8"?>
<animator xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:duration="@integer/stroke_fade_in_fade_out_animation_duration"
    android:repeatCount="@integer/stroke_fade_in_fade_out_animation_repeat_count">
    <propertyValuesHolder>
        <keyframe android:value="@color/transparent"/>
        <keyframe android:value="@color/error"/>
        <keyframe android:value="@color/transparent"/>
    </propertyValuesHolder>
</animator>
