<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/assets_selection_close_button"
            android:layout_width="@dimen/assets_selection_close_button_size"
            android:layout_height="@dimen/assets_selection_close_button_size"
            app:layout_constraintBottom_toBottomOf="@+id/assets_selection_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/assets_selection_title"/>
        <Constraint
            android:id="@+id/assets_selection_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/assets_selection_title_margin_start"
            android:layout_marginEnd="@dimen/assets_selection_title_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/assets_selection_close_button"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/divider_header_asset"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_separator_height"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:alpha="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/assets_selection_title"/>
        <Constraint
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_margin_text_vertical"
            android:layout_marginStart="@dimen/item_margin_end_text_horizontal"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintEnd_toStartOf="@+id/item_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_header_asset"/>
        <Constraint
            android:id="@+id/item_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:layout_marginStart="@dimen/item_margin_end_text_horizontal"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintEnd_toStartOf="@+id/item_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_title"/>
        <Constraint
            android:id="@+id/item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/item_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/item_title"/>
        <Constraint
            android:id="@+id/divider_recycler_asset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_separator_height"
            android:layout_marginTop="@dimen/item_margin_text_vertical"
            android:alpha="1"
            app:layout_constraintTop_toBottomOf="@+id/item_description"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/assets_selection_close_button"
            android:layout_width="@dimen/assets_selection_close_button_size"
            android:layout_height="@dimen/assets_selection_close_button_size"
            app:layout_constraintBottom_toBottomOf="@+id/assets_selection_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/assets_selection_title"/>
        <Constraint
            android:id="@+id/assets_selection_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/assets_selection_title_margin_start"
            android:layout_marginEnd="@dimen/assets_selection_title_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/assets_selection_close_button"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/divider_header_asset"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_separator_height"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/assets_selection_title"/>
        <Constraint
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_margin_text_vertical_end"
            android:layout_marginStart="@dimen/item_margin_end_text_horizontal"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintEnd_toStartOf="@+id/item_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_header_asset"/>
        <Constraint
            android:id="@+id/item_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:layout_marginStart="@dimen/item_margin_end_text_horizontal"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/item_title"
            app:layout_constraintEnd_toStartOf="@+id/item_switch"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_margin_end_text_horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/item_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/item_title"/>
        <Constraint
            android:id="@+id/divider_recycler_asset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_separator_height"
            android:layout_marginTop="@dimen/item_margin_text_vertical"
            android:alpha="0"
            app:layout_constraintTop_toBottomOf="@+id/item_switch"/>
    </ConstraintSet>
    <Transition
        android:id="@+id/transition_asset_selection"
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="1000">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/recycler"
            app:touchAnchorSide="top"/>
    </Transition>
</MotionScene>
