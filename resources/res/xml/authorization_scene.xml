<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/registration_to_login_transition"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="@android:integer/config_mediumAnimTime"
        motion:motionInterpolator="easeInOut">
        <KeyFrameSet/>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/registration_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_and_login_title_margin_top"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/login_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_and_login_title_margin_top"
            motion:layout_constraintStart_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:gravity="center_horizontal"
            android:id="@+id/registration_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_title_margin_bottom"
            motion:layout_constraintEnd_toStartOf="@+id/login_title"
            motion:layout_constraintHorizontal_weight="1"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/registration_and_login_barrier">
            <CustomAttribute
                motion:attributeName="textColor"
                motion:customColorValue="@color/registrationAndLoginTitleTextEnabled"/>
        </Constraint>
        <Constraint
            android:gravity="center_horizontal"
            android:id="@+id/login_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            motion:layout_constraintBaseline_toBaselineOf="@+id/registration_title"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_weight="1"
            motion:layout_constraintStart_toEndOf="@+id/registration_title">
            <CustomAttribute
                motion:attributeName="textColor"
                motion:customColorValue="@color/registrationAndLoginTitleTextDisabled"/>
        </Constraint>
        <Constraint
            android:id="@+id/registration_and_login_slider"
            android:layout_width="@dimen/registration_and_login_slider_width"
            android:layout_height="@dimen/registration_and_login_slider_height"
            android:layout_marginBottom="@dimen/registration_and_login_slider_margin_bottom"
            motion:layout_constraintBottom_toBottomOf="@+id/registration_title"
            motion:layout_constraintEnd_toEndOf="@+id/registration_title"
            motion:layout_constraintStart_toStartOf="@+id/registration_title">
            <CustomAttribute
                motion:attributeName="ColorFilter"
                motion:customColorValue="@color/registrationSlider"/>
        </Constraint>
        <Constraint
            android:id="@+id/registration_agreement_container"
            android:paddingLeft="@dimen/common_margin_horizontal"
            android:paddingRight="@dimen/common_margin_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/license_check_box_margin_top"
            android:paddingHorizontal="@dimen/common_margin_horizontal"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/curr_radio_group_container"/>
        <Constraint
            android:id="@+id/login_forgot_password_text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forgot_password_button_margin_top"
            motion:layout_constraintStart_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout"/>
        <Constraint
            android:id="@+id/loginButtonFrame"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/common_margin_horizontal"
            android:layout_marginEnd="@dimen/common_margin_horizontal"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/registrationButtonFrame"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/common_margin_horizontal"
            android:layout_marginEnd="@dimen/common_margin_horizontal"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/registration_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_and_login_title_margin_top"
            motion:layout_constraintEnd_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/login_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_and_login_title_margin_top"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:gravity="center_horizontal"
            android:id="@+id/registration_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_title_margin_bottom"
            motion:layout_constraintEnd_toStartOf="@+id/login_title"
            motion:layout_constraintHorizontal_weight="1"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/registration_and_login_barrier">
            <CustomAttribute
                motion:attributeName="textColor"
                motion:customColorValue="@color/registrationAndLoginTitleTextDisabled"/>
        </Constraint>
        <Constraint
            android:gravity="center_horizontal"
            android:id="@+id/login_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            motion:layout_constraintBaseline_toBaselineOf="@+id/registration_title"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_weight="1"
            motion:layout_constraintStart_toEndOf="@+id/registration_title">
            <CustomAttribute
                motion:attributeName="textColor"
                motion:customColorValue="@color/registrationAndLoginTitleTextEnabled"/>
        </Constraint>
        <Constraint
            android:id="@+id/registration_and_login_slider"
            android:layout_width="@dimen/registration_and_login_slider_width"
            android:layout_height="@dimen/registration_and_login_slider_height"
            android:layout_marginBottom="@dimen/registration_and_login_slider_margin_bottom"
            motion:layout_constraintBottom_toBottomOf="@+id/login_title"
            motion:layout_constraintEnd_toEndOf="@+id/login_title"
            motion:layout_constraintStart_toStartOf="@+id/login_title">
            <CustomAttribute
                motion:attributeName="colorFilter"
                motion:customColorValue="@color/loginSlider"/>
        </Constraint>
        <Constraint
            android:id="@+id/registration_agreement_container"
            android:paddingLeft="@dimen/common_margin_horizontal"
            android:paddingRight="@dimen/common_margin_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/license_check_box_margin_top"
            android:paddingHorizontal="@dimen/common_margin_horizontal"
            motion:layout_constraintEnd_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/curr_radio_group_container"/>
        <Constraint
            android:id="@+id/login_forgot_password_text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forgot_password_button_margin_top"
            android:layout_marginEnd="@dimen/common_margin_horizontal"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout"/>
        <Constraint
            android:id="@+id/loginButtonFrame"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/common_margin_horizontal"
            android:layout_marginEnd="@dimen/common_margin_horizontal"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/registrationButtonFrame"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/common_margin_horizontal"
            android:layout_marginEnd="@dimen/common_margin_horizontal"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
    </ConstraintSet>
</MotionScene>
