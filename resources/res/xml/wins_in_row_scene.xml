<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/transition_set1_to_set2"
        motion:constraintSetEnd="@+id/set2"
        motion:constraintSetStart="@+id/set1"
        motion:duration="@integer/profit_limit_with_activation_dialog_progress_bar_animation_duration"
        motion:motionInterpolator="easeInOut"/>
    <Transition
        android:id="@+id/transition_set2_to_set3"
        motion:constraintSetEnd="@+id/set3"
        motion:constraintSetStart="@+id/set2"
        motion:duration="@integer/profit_limit_with_activation_dialog_fade_in_animation_duration"/>
    <ConstraintSet android:id="@+id/set1">
        <Constraint
            android:orientation="vertical"
            android:id="@+id/profit_limit_with_activation_dialog_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintGuide_percent="0.1"/>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_progress_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/profit_limit_with_activation_dialog_progress_bar_height"
            android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_cup_margin_bottom"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_cup">
            <CustomAttribute
                motion:attributeName="progress"
                motion:customIntegerValue="1000"/>
        </Constraint>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_amount"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBaseline_toBaselineOf="@+id/profit_limit_with_activation_dialog_infinity"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_guideline"
            motion:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_guideline"/>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_infinity"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_infinity_margin_top"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_cup"
            motion:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_cup"
            motion:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_progress_bar"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/set2"
        motion:deriveConstraintsFrom="@+id/set1">
        <Constraint
            android:orientation="vertical"
            android:id="@+id/profit_limit_with_activation_dialog_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintGuide_percent="0.37"/>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_progress_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/profit_limit_with_activation_dialog_progress_bar_height"
            android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_cup_margin_bottom"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_cup">
            <CustomAttribute
                motion:attributeName="progress"
                motion:customIntegerValue="3700"/>
        </Constraint>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_amount"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBaseline_toBaselineOf="@+id/profit_limit_with_activation_dialog_infinity"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_guideline"
            motion:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_guideline"/>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_infinity"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_infinity_margin_top"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_cup"
            motion:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_cup"
            motion:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_progress_bar"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/set3"
        motion:deriveConstraintsFrom="@+id/set2">
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_amount"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBaseline_toBaselineOf="@+id/profit_limit_with_activation_dialog_infinity"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_guideline"
            motion:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_guideline"/>
        <Constraint
            android:id="@+id/profit_limit_with_activation_dialog_infinity"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_infinity_margin_top"
            motion:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_progress_bar"
            motion:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_progress_bar"/>
    </ConstraintSet>
</MotionScene>
