<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item android:end="180dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <gradient
                android:startColor="@color/gradientAI1"
                android:endColor="@color/gradientAI3"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/gradientAI2"/>
        </shape>
    </item>
    <item android:start="80dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <gradient
                android:startColor="@color/gradientAI2"
                android:endColor="@color/gradientAI4"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/gradientAI3"/>
        </shape>
    </item>
    <item
        android:left="@dimen/common_stroke_width"
        android:top="@dimen/common_stroke_width"
        android:right="@dimen/common_stroke_width"
        android:bottom="@dimen/common_stroke_width">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <gradient
                android:startColor="@color/surface"
                android:endColor="@color/altSurface"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
</ripple>
