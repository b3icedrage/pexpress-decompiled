<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/robot_fragment_checked"
        android:drawable="@drawable/ic_bottom_navigation_robot_active"/>
    <item
        android:id="@+id/robot_fragment_unchecked"
        android:drawable="@drawable/ic_bottom_navigation_robot_inactive_animated"/>
    <transition
        android:drawable="@drawable/ic_bottom_navigation_robot_inactive_animated"
        android:toId="@+id/robot_fragment_unchecked"
        android:fromId="@+id/robot_fragment_checked"/>
    <transition
        android:drawable="@drawable/ic_bottom_navigation_robot_active"
        android:toId="@+id/robot_fragment_checked"
        android:fromId="@+id/robot_fragment_unchecked"/>
</animated-selector>
