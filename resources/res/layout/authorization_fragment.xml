<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registration_and_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/RegistrationAndLoginRootContainer">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/registration_motion_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/authorization_scene"
        style="@style/RegistrationAndLoginMotionLayout">
        <TextView
            android:id="@+id/registration_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/RegisterAndLoginHeader"/>
        <TextView
            android:id="@+id/login_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/RegisterAndLoginHeader"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/registration_and_login_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="login_header,registration_header"/>
        <TextView
            android:id="@+id/registration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registration"
            android:textAlignment="center"
            style="@style/RegistrationAndLoginTitle"/>
        <TextView
            android:id="@+id/login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_in"
            android:textAlignment="center"
            style="@style/RegistrationAndLoginTitle"/>
        <ImageView
            android:id="@+id/registration_and_login_slider"
            android:layout_width="@dimen/registration_and_login_slider_width"
            android:layout_height="@dimen/registration_and_login_slider_height"
            android:src="@drawable/registration_and_login_tab_slider"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emailTextInputLayout_margin_top"
            android:layout_marginStart="@dimen/registration_email_input_layout_margin_start"
            android:layout_marginEnd="@dimen/registration_email_input_layout_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/registration_and_login_slider"
            style="@style/RegistrationAndLoginEmailTextInputLayout">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/activation_register_text_input_height"
                style="@style/RegistrationAndLoginEmailEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <include
            android:id="@+id/emailHint"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/common_error_hint_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            layout="@layout/input_error_label"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_password_input_layout_margin_top"
            android:layout_marginStart="@dimen/registration_password_input_layout_margin_start"
            android:layout_marginEnd="@dimen/registration_password_input_layout_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            style="@style/RegistrationAndLoginPasswordTextInputLayout">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/activation_register_text_input_height"
                style="@style/RegistrationAndLoginPasswordEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <include
            android:id="@+id/passwordHint"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/common_error_hint_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout"
            layout="@layout/input_error_label"/>
        <FrameLayout
            android:id="@+id/curr_radio_group_container"
            android:paddingLeft="@dimen/registration_margin_currency_horizontal"
            android:paddingTop="@dimen/registration_margin_currency_top"
            android:paddingRight="@dimen/registration_margin_currency_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/registration_margin_currency_horizontal"
            app:layout_constraintEnd_toEndOf="@+id/registration_agreement_container"
            app:layout_constraintStart_toStartOf="@+id/registration_agreement_container"
            app:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout">
            <com.api.resources.IndicatorRadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/radio_group"
                android:layout_width="match_parent"
                android:layout_height="@dimen/registration_height_currency">
                <com.api.resources.RadioIndicatorButton
                    android:id="@+id/radio_btn_one"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/registration_margin_currency"
                    android:layout_marginRight="@dimen/registration_margin_currency"
                    android:text="@string/usd"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
                <com.api.resources.RadioIndicatorButton
                    android:id="@+id/radio_btn_two"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/registration_margin_currency"
                    android:layout_marginRight="@dimen/registration_margin_currency"
                    android:text="@string/eur"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
                <com.api.resources.RadioIndicatorButton
                    android:id="@+id/radio_btn_three"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/registration_margin_currency"
                    android:layout_marginRight="@dimen/registration_margin_currency"
                    android:text="@string/gbp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
            </com.api.resources.IndicatorRadioGroup>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/registration_agreement_container"
            android:paddingLeft="@dimen/common_margin_horizontal"
            android:paddingRight="@dimen/common_margin_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/common_margin_horizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/registration_agreement_check_box"
                android:layout_width="@dimen/registration_licence_checkbox_width"
                android:layout_height="@dimen/registration_licence_checkbox_height"
                android:layout_marginTop="@dimen/registration_agreement_check_box_padding_top"
                style="@style/RegistrationAgreementCheckBox"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/registration_agreement_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/registration_agreement_text_margin_start"
                style="@style/RegistrationAgreement"/>
        </LinearLayout>
        <TextView
            android:id="@+id/login_forgot_password_text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password_text"
            style="@style/LoginForgotPasswordText"/>
        <FrameLayout
            android:id="@+id/registration_and_login_loading_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/registrationButtonFrame"
            app:layout_constraintEnd_toEndOf="@+id/registrationButtonFrame"
            app:layout_constraintStart_toStartOf="@+id/registrationButtonFrame"
            app:layout_constraintTop_toTopOf="@+id/registrationButtonFrame"
            style="@style/RegistrationAndLoginSpitKitView">
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/registration_and_login_loading_progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/RegistrationAndLoginSpitKitView"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/loginButtonFrame"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_in"
                style="@style/LoginActionButton"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/registrationButtonFrame"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register"
                style="@style/RegisterActionButton"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/full_screen_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/registration_full_screen_loading_elevation"
            style="@style/RegistrationAndLoginSocialLoginContainer">
            <ImageView
                android:id="@+id/registration_soc_login_close_image_button"
                android:padding="@dimen/common_margin_horizontal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close"
                android:elevation="@dimen/registration_full_screen_loading_items_common_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/registration_soc_login_logged_progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RegistrationAndLoginSocialLoginSpinKitView"/>
            <ImageView
                android:id="@+id/registration_soc_login_loading_image"
                android:visibility="gone"
                android:layout_width="@dimen/registration_soc_login_loading_image_edge"
                android:layout_height="@dimen/registration_soc_login_loading_image_edge"
                android:elevation="@dimen/registration_full_screen_loading_items_common_elevation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ProgressBar
                android:id="@+id/registration_soc_login_loading_progress_bar"
                android:visibility="gone"
                android:layout_width="@dimen/registration_soc_login_progress_edge"
                android:layout_height="@dimen/registration_soc_login_progress_edge"
                android:elevation="@dimen/registration_full_screen_loading_items_common_elevation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RegistrationAndLoginSocialLoginCircularProgressBar"/>
            <TextView
                android:id="@+id/registration_soc_login_loading_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/registration_soc_login_loading_text_margin_top"
                android:elevation="@dimen/registration_full_screen_loading_items_common_elevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/registration_soc_login_loading_progress_bar"
                style="@style/RegistrationAndLoginSocialLoginTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/registration_and_login_blocking_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/BlockingView"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</FrameLayout>
