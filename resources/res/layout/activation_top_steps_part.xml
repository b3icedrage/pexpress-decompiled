<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivationBlockRootContainer.TopSteps">
    <ImageView
        android:id="@+id/activation_top_steps_first_to_second_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:src="@drawable/ic_stepper_rounded_rectangle"
        android:layout_marginStart="@dimen/activation_top_steps_progress_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/activation_top_steps_second_to_third_progress"
        app:layout_constraintStart_toStartOf="@+id/activation_top_steps_first_circle"
        app:layout_constraintTop_toTopOf="@+id/activation_top_steps_first_circle"/>
    <ImageView
        android:id="@+id/activation_top_steps_second_to_third_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_stepper_rounded_rectangle"
        android:layout_marginEnd="@dimen/activation_top_steps_progress_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/activation_top_steps_first_to_second_progress"
        app:layout_constraintEnd_toEndOf="@+id/activation_top_steps_third_circle"
        app:layout_constraintStart_toEndOf="@+id/activation_top_steps_first_to_second_progress"
        app:layout_constraintTop_toTopOf="@+id/activation_top_steps_first_to_second_progress"/>
    <include
        android:id="@+id/activation_top_steps_first_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activation_top_steps_first_circle_margin_top"
        android:layout_marginStart="@dimen/activation_top_steps_first_circle_margin_start"
        app:layout_constraintEnd_toStartOf="@+id/activation_top_steps_second_circle"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/stepper_step"/>
    <include
        android:id="@+id/activation_top_steps_second_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activation_top_steps_second_circle_margin_horizontal"
        android:layout_marginRight="@dimen/activation_top_steps_second_circle_margin_horizontal"
        android:layout_marginHorizontal="@dimen/activation_top_steps_second_circle_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/activation_top_steps_third_circle"
        app:layout_constraintStart_toEndOf="@+id/activation_top_steps_first_circle"
        app:layout_constraintTop_toTopOf="@+id/activation_top_steps_first_circle"
        layout="@layout/stepper_step"/>
    <include
        android:id="@+id/activation_top_steps_third_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activation_top_steps_third_circle_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/activation_top_steps_second_circle"
        app:layout_constraintTop_toTopOf="@+id/activation_top_steps_second_circle"
        layout="@layout/stepper_step"/>
</androidx.constraintlayout.widget.ConstraintLayout>
