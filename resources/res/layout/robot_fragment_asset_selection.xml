<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotAssetSelectionRootContainer">
    <TextView
        android:id="@+id/trading_asset_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_progress"
        android:text="@string/bot_settings_trading_assets"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotCommonSubsectionTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/asset_value_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/maximum_profit_value_holder_height"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trading_asset_title"
        style="@style/RobotMaterialCardView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer">
            <ImageView
                android:id="@+id/asset_icon"
                android:layout_width="@dimen/asset_icon_width"
                android:layout_height="@dimen/asset_icon_height"
                android:layout_marginEnd="@dimen/asset_icon_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/asset_icon_barrier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotTradingOptionsAssetIcon"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/asset_icon_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="asset_icon"/>
            <TextView
                android:id="@+id/asset_auto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_prefix"
                android:paddingEnd="@dimen/asset_percents_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/asset_icon_barrier"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Body.Bold.Grey"/>
            <TextView
                android:id="@+id/asset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/asset_percents"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/asset_auto_text"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue.Asset"/>
            <TextView
                android:id="@+id/asset_percents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/asset_percents_margin_start"
                android:layout_marginEnd="@dimen/asset_percents_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/asset_icon_next"
                app:layout_constraintStart_toEndOf="@+id/asset_name"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue.Percents"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/asset_icon_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/asset_shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer.RobotAssetShimmerContainer">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/asset_icon_shimmer"
                    android:layout_width="@dimen/asset_icon_width"
                    android:layout_height="@dimen/asset_icon_width"
                    android:src="@drawable/ic_asset_icon_placeholder"/>
                <ImageView
                    android:id="@+id/asset_text_shimmer"
                    android:layout_width="@dimen/asset_text_shimmer_width"
                    android:layout_height="@dimen/asset_text_shimmer_height"
                    android:src="@drawable/ic_asset_text_placeholder"
                    android:layout_marginStart="@dimen/asset_text_shimmer_margin_start"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
