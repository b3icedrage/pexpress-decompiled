<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotTradingSignalCurrentInvestmentMaterialCardView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/indicators_summary_icon_image"
            android:layout_width="@dimen/indicators_summary_current_investment_icon_width"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/indicators_summary_current_investment_icon_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/indicators_summary_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indicators_summary_current_investment_title_margin_top"
            android:text="@string/indiciator_summary"
            android:layout_marginStart="@dimen/indicators_summary_current_investment_title_margin_start"
            app:layout_constraintEnd_toEndOf="@+id/indicators_summary_current_investment_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotIndicatorsSummaryCurrentInvestmentTitle"/>
        <TextView
            android:id="@+id/indicators_summary_current_investment_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indicators_summary_current_investment_description_margin_top"
            android:text="@string/boost_accuracy"
            android:layout_marginEnd="@dimen/indicators_summary_current_investment_description_margin_end"
            app:layout_constraintBottom_toTopOf="@+id/indicators_summary_activate_button"
            app:layout_constraintEnd_toStartOf="@+id/indicators_summary_icon_image"
            app:layout_constraintStart_toStartOf="@+id/indicators_summary_title"
            app:layout_constraintTop_toBottomOf="@+id/indicators_summary_title"
            app:layout_constraintVertical_bias="1"
            style="@style/RobotIndicatorsSummaryDescription"/>
        <TextView
            android:id="@+id/indicators_summary_activate_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indicators_summary_current_investment_activate_button_margin_top"
            android:layout_marginBottom="@dimen/indicators_summary_current_investment_activate_button_margin_bottom"
            android:text="@string/activate_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/indicators_summary_title"
            app:layout_constraintTop_toBottomOf="@+id/indicators_summary_current_investment_description"
            style="@style/RobotIndicatorsSummaryActivateButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
