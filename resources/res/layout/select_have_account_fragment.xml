<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/SelectHaveAccountRootContainer">
    <ImageView
        android:id="@+id/select_have_account_outer_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/select_have_account_outer_image_margin_top"
        android:layout_marginBottom="@dimen/select_have_account_outer_image_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/select_have_account_title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SelectHaveAccountOuterImage"/>
    <ImageView
        android:id="@+id/select_have_account_inner_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/select_have_account_outer_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/select_have_account_outer_image"
        style="@style/SelectHaveAccountInnerImage"/>
    <TextView
        android:id="@+id/select_have_account_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/select_have_account_title_text_margin_horizontal"
        android:layout_marginRight="@dimen/select_have_account_title_text_margin_horizontal"
        android:layout_marginBottom="@dimen/select_have_account_title_text_margin_bottom"
        android:layout_marginHorizontal="@dimen/select_have_account_title_text_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/select_have_account_sign_in_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_have_account_outer_image"
        style="@style/SelectHaveAccountTitle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/select_have_account_register_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/not_our_user_sign_in_margin_bottom"
        android:text="@string/create_new_account_button"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toTopOf="@+id/select_have_account_sign_in_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SelectHaveAccountRegisterActionButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/select_have_account_sign_in_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/not_our_user_sign_in_margin_bottom"
        android:text="@string/log_in"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SelectHaveAccountLoginActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
