<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/indicator_selection_main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/common_outer_margin"
    android:layout_marginRight="@dimen/common_outer_margin"
    android:layout_marginHorizontal="@dimen/common_outer_margin"
    style="@style/AltRobotMaterialCardView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/indicator_selection_container"
        android:paddingBottom="@dimen/common_outer_margin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="center"
            android:id="@+id/indicator_selection_illustration"
            android:background="@drawable/indicator_illustration_bg"
            android:layout_width="@dimen/strategy_selection_illustration_width"
            android:layout_height="@dimen/strategy_selection_illustration_width"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/indicator_params_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:id="@+id/indicator_selection_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintStart_toEndOf="@+id/indicator_selection_illustration"
            app:layout_constraintTop_toTopOf="@+id/indicator_selection_illustration"
            style="@style/RobotStrategyTitle"/>
        <ImageView
            android:id="@+id/indicator_selection_lock_icon_v1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lock_24"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_selection_title"
            app:layout_constraintStart_toEndOf="@+id/indicator_selection_title"
            app:layout_constraintTop_toTopOf="@+id/indicator_selection_title"/>
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/indicator_selection_radio_button"
            android:layout_width="@dimen/common_icon_size"
            android:layout_height="@dimen/common_icon_size"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_selection_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/indicator_selection_title"
            style="@style/RobotStrategyRadioButton"/>
        <ImageView
            android:id="@+id/indicator_selection_lock_icon_v2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lock_activation"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_selection_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/indicator_selection_title"/>
        <ImageButton
            android:id="@+id/indicator_selection_arrow_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_selection_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/indicator_selection_title"
            style="@style/RobotStrategyArrowNextButton"/>
        <TextView
            android:id="@+id/indicator_selection_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/strategy_selection_recommended_balance_margin_top"
            android:text="@string/recommended_balance_text"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/indicator_selection_title"
            app:layout_constraintTop_toBottomOf="@+id/indicator_selection_title"
            app:layout_constraintVertical_bias="0"
            style="@style/RobotStrategyDescription"/>
        <TextView
            android:id="@+id/indicator_params_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/strategy_selection_recommended_balance_margin_top"
            android:text="@string/recommended_balance_text"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/indicator_selection_description"
            app:layout_constraintTop_toBottomOf="@+id/indicator_selection_description"
            app:layout_constraintVertical_bias="0"
            style="@style/RobotStrategyDescription"/>
        <TextView
            android:id="@+id/indicator_show_details"
            android:paddingLeft="@dimen/trading_indicator_show_details_common_padding"
            android:paddingTop="@dimen/trading_indicator_show_details_common_padding"
            android:paddingRight="@dimen/trading_indicator_show_details_common_padding"
            android:paddingBottom="@dimen/common_outer_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trading_indicator_show_details_common_padding"
            android:layout_marginStart="@dimen/trading_indicator_show_details_margin_start"
            android:paddingHorizontal="@dimen/trading_indicator_show_details_common_padding"
            app:layout_constraintEnd_toEndOf="@+id/indicator_selection_description"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/indicator_selection_description"
            app:layout_constraintTop_toBottomOf="@+id/indicator_params_description"
            style="@style/RobotShowDetails"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/indicator_show_details_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_spacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator_params_description"
            app:layout_goneMarginEnd="@dimen/common_outer_margin"
            style="@style/CustomActionButton.Small.Grey"/>
        <View
            android:id="@+id/btn_spacer"
            android:layout_width="@dimen/margin_medium"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/indicator_edit_btn"
            app:layout_constraintStart_toEndOf="@+id/indicator_show_details_btn"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/indicator_edit_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_spacer"
            app:layout_constraintTop_toBottomOf="@+id/indicator_params_description"
            style="@style/CustomActionButton.Small.Grey"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/robot_trading_indicator_selection_shimmer_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/indicator_shimmer_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/common_outer_margin"
                android:src="@drawable/ic_indicator_shimmer_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicator_shimmer_label_1"
                android:layout_width="@dimen/root_shimmer_label_1_width"
                android:layout_height="@dimen/root_shimmer_label_1_height"
                android:layout_marginStart="@dimen/common_outer_margin"
                app:layout_constraintStart_toEndOf="@+id/indicator_shimmer_image"
                app:layout_constraintTop_toTopOf="@+id/indicator_shimmer_image"
                style="@style/RobotIndicatorShimmerCard"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicator_shimmer_label_2"
                android:layout_width="@dimen/root_shimmer_label_2_width"
                android:layout_height="@dimen/root_shimmer_label_2_height"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintStart_toStartOf="@+id/indicator_shimmer_label_1"
                app:layout_constraintTop_toBottomOf="@+id/indicator_shimmer_label_1"
                style="@style/RobotIndicatorShimmerCard"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicator_shimmer_label_3"
                android:layout_width="@dimen/root_shimmer_label_3_width"
                android:layout_height="@dimen/root_shimmer_label_3_height"
                android:layout_marginTop="@dimen/margin_small_medium"
                android:layout_marginBottom="@dimen/margin_top_tv_dismiss"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/indicator_shimmer_label_1"
                app:layout_constraintTop_toBottomOf="@+id/indicator_shimmer_label_2"
                style="@style/RobotIndicatorShimmerCard"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <ProgressBar
        android:layout_gravity="end"
        android:id="@+id/trading_indicator_progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/common_outer_margin"
        android:layout_height="@dimen/common_outer_margin"
        android:layout_margin="@dimen/margin_top_tv_dismiss"
        style="@style/RobotIndicatorProgress"/>
</com.google.android.material.card.MaterialCardView>
