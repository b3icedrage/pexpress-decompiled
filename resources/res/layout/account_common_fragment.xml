<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:background="@color/accountCommonBackground"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/account_main_info_part_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/account_main_info_rating_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_common_spacer_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/account_balance_part_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/account_balance_settings_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_common_spacer_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/account_settings_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/account_settings_logout_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_common_spacer_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/account_logout_part_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/account_logout_bottom_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/account_common_spacer_height"
                android:alpha="0"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
