<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/asset_selection_body_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:minHeight="@dimen/asset_selection_body_title_container_min_height"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/asset_selection_body_title_container_margin_end"
        app:layout_constraintBottom_toTopOf="@+id/asset_selection_body_lower_label"
        app:layout_constraintEnd_toStartOf="@+id/asset_selection_body_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/asset_selection_body_upper_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/asset_selection_body_upper_label_margin_bottom"
            app:layout_constraintBottom_toTopOf="@+id/asset_selection_body_title"
            app:layout_constraintEnd_toEndOf="@+id/asset_selection_body_title"
            app:layout_constraintStart_toStartOf="@+id/asset_selection_body_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/AssetSelectionCardBodyUpperLabel"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/asset_selection_body_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/AssetSelectionCardBodyTitle"/>
    </LinearLayout>
    <TextView
        android:id="@+id/asset_selection_body_lower_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/asset_selection_body_lower_label_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/asset_selection_body_description"
        app:layout_constraintEnd_toEndOf="@+id/asset_selection_body_title_container"
        app:layout_constraintStart_toStartOf="@+id/asset_selection_body_title_container"
        style="@style/AssetSelectionCardBodyLowerLabel"/>
    <ImageView
        android:id="@+id/asset_selection_body_icon"
        android:layout_width="@dimen/asset_selection_body_icon_size"
        android:layout_height="@dimen/asset_selection_body_icon_size"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/asset_selection_body_icon_margin_bottom"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/asset_selection_body_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/asset_selection_body_description_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/asset_selection_body_button"
        app:layout_constraintEnd_toEndOf="@+id/asset_selection_body_icon"
        app:layout_constraintStart_toStartOf="@+id/asset_selection_body_title_container"
        app:layout_goneMarginBottom="@dimen/asset_selection_body_description_margin_bottom"
        style="@style/AssetSelectionCardBodyDescription"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/asset_selection_body_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/common_outer_margin"
        android:text="@string/change_rule_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/asset_selection_body_icon"
        app:layout_constraintStart_toStartOf="@+id/asset_selection_body_title_container"
        style="@style/AssetSelectionCardButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
