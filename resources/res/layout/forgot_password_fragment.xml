<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgot_password_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/ForgotPasswordRootContainer">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/forgot_password_app_bar_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.api.resources.CenteredToolbar
                android:id="@+id/forgot_password_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/forgot_password"
                style="@style/ForgotPasswordToolbar"/>
        </com.google.android.material.appbar.AppBarLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/forgot_password_email_text_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forgot_password_app_bar_layout"
            style="@style/ForgotPasswordEmailTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/forgetPassEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/ForgotPasswordEmailEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <include
            android:id="@+id/emailHint"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/common_error_hint_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            layout="@layout/input_error_label"/>
        <TextView
            android:id="@+id/forget_password_description_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/forgot_password_description_margin_horizontal"
            android:layout_marginTop="@dimen/forgot_password_description_margin_top"
            android:layout_marginRight="@dimen/forgot_password_description_margin_horizontal"
            android:text="@string/forgot_password_description"
            android:layout_marginHorizontal="@dimen/forgot_password_description_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            style="@style/ForgetPasswordDescription"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgot_password_reset_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginBottom="@dimen/forgot_password_reset_password_button_margin_bottom"
            android:text="@string/reset_password_text"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ForgotPasswordResetPasswordButton"/>
        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/loadingProgressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/forgot_password_reset_button"
            app:layout_constraintEnd_toEndOf="@+id/forgot_password_reset_button"
            app:layout_constraintStart_toStartOf="@+id/forgot_password_reset_button"
            app:layout_constraintTop_toTopOf="@+id/forgot_password_reset_button"
            style="@style/ForgotPasswordSpinKitView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
