<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/popular_question_card_width"
    android:layout_height="match_parent"
    style="@style/PopularQuestionItemContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/popular_question_icon"
            android:layout_width="@dimen/popular_question_icon_size"
            android:layout_height="@dimen/popular_question_icon_size"
            android:layout_margin="@dimen/common_outer_margin"
            android:src="@drawable/ic_profile_on_active_robot"
            app:layout_constraintBottom_toTopOf="@+id/popular_question_item_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/popular_question_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_outer_margin"
            android:layout_marginRight="@dimen/common_outer_margin"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginHorizontal="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/popular_question_icon"
            style="@style/PopularQuestionItemText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
