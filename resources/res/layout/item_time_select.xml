<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_time_select_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_time_select_height"
    style="@style/TimeSelectionItemRootContainer">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/fragment_time_select_icon"
        android:layout_width="@dimen/time_selection_icon_size"
        android:layout_height="@dimen/time_selection_icon_size"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:src="@drawable/ic_help_trading_options_clock"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        style="@style/TimeSelectionIcon"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/fragment_time_select_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/RobotRecyclerItemCommonTitleSelectionItemTitle"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fragment_time_select_percent_margin_end"
        style="@style/TimeSelectionPercent"/>
    <com.google.android.material.radiobutton.MaterialRadioButton
        android:layout_gravity="center_vertical"
        android:id="@+id/fragment_time_select_radio_button"
        android:layout_width="@dimen/fragment_time_select_radio_button_size"
        android:layout_height="@dimen/fragment_time_select_radio_button_size"
        android:layout_marginEnd="@dimen/common_outer_margin"
        style="@style/AltRobotRadioButton.Time"/>
</LinearLayout>
