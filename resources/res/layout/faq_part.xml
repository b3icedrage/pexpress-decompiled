<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/faq_container_padding_top"
    android:paddingBottom="@dimen/faq_container_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/FaqContainer">
    <TextView
        android:id="@+id/faq_title"
        android:paddingBottom="@dimen/faq_title_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/faq_title"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FaqTitle"/>
    <ImageView
        android:id="@+id/faq_part_trading_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/faq_part_common_margin_top"
        android:src="@drawable/ic_trading_graph"
        app:layout_constraintStart_toStartOf="@+id/faq_title"
        app:layout_constraintTop_toBottomOf="@+id/faq_title"/>
    <TextView
        android:id="@+id/faq_part_trading_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/trading_text"
        android:layout_marginStart="@dimen/faq_part_title_common_margin_start"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/faq_part_trading_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faq_part_trading_icon"
        app:layout_constraintTop_toTopOf="@+id/faq_part_trading_icon"
        style="@style/FaqPartCommonTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/faq_part_trading_item_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_trading_title"/>
    <ImageView
        android:id="@+id/faq_part_robots_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/faq_part_common_margin_top"
        android:src="@drawable/ic_robot_signals"
        app:layout_constraintStart_toStartOf="@+id/faq_title"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_trading_item_placeholder"/>
    <TextView
        android:id="@+id/faq_part_robots_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/robot_text"
        android:layout_marginStart="@dimen/faq_part_title_common_margin_start"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/faq_part_robots_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faq_part_robots_icon"
        app:layout_constraintTop_toTopOf="@+id/faq_part_robots_icon"
        style="@style/FaqPartCommonTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/faq_part_robots_item_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_robots_title"/>
    <ImageView
        android:id="@+id/faq_part_account_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/faq_part_common_margin_top"
        android:src="@drawable/ic_account_settings_profile"
        app:layout_constraintStart_toStartOf="@+id/faq_title"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_robots_item_placeholder"/>
    <TextView
        android:id="@+id/faq_part_account_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/account_text"
        android:layout_marginStart="@dimen/faq_part_title_common_margin_start"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/faq_part_account_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faq_part_account_icon"
        app:layout_constraintTop_toTopOf="@+id/faq_part_account_icon"
        style="@style/FaqPartCommonTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/faq_part_account_item_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_account_title"/>
    <ImageView
        android:id="@+id/faq_part_deposit_withdraw_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/faq_part_common_margin_top"
        android:src="@drawable/ic_account_balance_deposit"
        app:layout_constraintStart_toStartOf="@+id/faq_title"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_account_item_placeholder"/>
    <TextView
        android:id="@+id/faq_part_deposit_withdraw_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/deposit_withdraw_title"
        android:layout_marginStart="@dimen/faq_part_title_common_margin_start"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/faq_part_deposit_withdraw_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faq_part_deposit_withdraw_icon"
        app:layout_constraintTop_toTopOf="@+id/faq_part_deposit_withdraw_icon"
        style="@style/FaqPartCommonTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/faq_part_deposit_withdraw_item_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/faq_part_deposit_withdraw_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
