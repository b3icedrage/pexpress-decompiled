<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ProfileErrorLabelContainer">
    <ImageView
        android:id="@+id/profile_input_error_label_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profile_input_error_label_icon_margin"
        android:src="@drawable/ic_warning"
        android:layout_marginStart="@dimen/profile_input_error_label_icon_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/profile_input_error_description_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profile_input_error_description_text_margin_vertical"
        android:layout_marginBottom="@dimen/profile_input_error_description_text_margin_vertical"
        android:layout_marginStart="@dimen/profile_input_error_description_text_margin_start"
        android:layout_marginEnd="@dimen/profile_input_error_description_text_margin_end"
        android:layout_marginVertical="@dimen/profile_input_error_description_text_margin_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profile_input_error_label_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ProfileErrorLabelDescription"/>
</androidx.constraintlayout.widget.ConstraintLayout>
