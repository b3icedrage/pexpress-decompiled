<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/PopularQuestionsContainer">
    <TextView
        android:id="@+id/how_can_we_help_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/need_help_title_margin_top"
        android:text="@string/chat_with_support_text"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HowCanWeHelpTitle"/>
    <TextView
        android:id="@+id/popular_questions_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popular_questions_title_margin_top"
        android:text="@string/popular_questions"
        app:layout_constraintEnd_toEndOf="@+id/how_can_we_help_title"
        app:layout_constraintStart_toStartOf="@+id/how_can_we_help_title"
        app:layout_constraintTop_toBottomOf="@+id/how_can_we_help_title"
        style="@style/PopularQuestionsTitle"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/question_list_shimmer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/popular_questions_title"
        app:layout_constraintTop_toBottomOf="@+id/popular_questions_title">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_popular_questions_shimmer"
            android:scaleType="fitXY"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/popular_questions_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popular_questions_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/highest_item"
            android:visibility="invisible"
            android:layout_width="@dimen/popular_question_card_width"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/popular_question_item"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
