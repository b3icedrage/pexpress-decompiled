<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/indicator_details_icon"
            android:background="@drawable/indicator_details_icon_background"
            android:layout_width="@dimen/indicator_details_icon_width"
            android:layout_height="@dimen/indicator_details_icon_width"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:scaleType="center"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/indicator_details_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/common_outer_margin"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintStart_toEndOf="@+id/indicator_details_icon"
            app:layout_constraintTop_toTopOf="@+id/indicator_details_icon"
            style="@style/RobotStrategyTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/indicator_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/title_with_switch_description_margin_bottom"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/indicator_details_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/indicator_details_title"
            app:layout_constraintTop_toBottomOf="@+id/indicator_details_title"/>
        <ImageView
            android:id="@+id/indicator_details_lock_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lock_24"
            app:layout_constraintStart_toEndOf="@+id/indicator_details_title"
            app:layout_constraintTop_toTopOf="@+id/indicator_details_title"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/indicator_details_page_illustration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_outer_margin"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginRight="@dimen/common_outer_margin"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator_details_icon"
            app:shapeAppearanceOverlay="@style/RobotStrategyIllustrationShape"/>
        <TextView
            android:id="@+id/indicator_details_page_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_big_medium"
            app:layout_constraintEnd_toEndOf="@+id/indicator_details_page_illustration"
            app:layout_constraintStart_toStartOf="@+id/indicator_details_page_illustration"
            app:layout_constraintTop_toBottomOf="@+id/indicator_details_page_illustration"
            style="@style/StrategySelectionPageDescription"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/indicator_details_bottom_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_outer_margin"
            android:layout_marginTop="@dimen/indicator_details_bottom_card_margin_top"
            android:layout_marginRight="@dimen/common_outer_margin"
            android:layout_marginHorizontal="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/indicator_details_card_bottom_separator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator_details_page_description"
            style="@style/IndicatorDetailBottomCard">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/indicator_details_bottom_card_title_first"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/common_outer_margin"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginRight="@dimen/common_outer_margin"
                    android:text="@string/summary_technical_indicators_title"
                    android:layout_marginHorizontal="@dimen/common_outer_margin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/IndicatorDetailBottomCardTitle"/>
                <TextView
                    android:id="@+id/indicator_details_bottom_card_details_first"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/summary_technical_indicators_list"
                    android:textDirection="locale"
                    app:layout_constraintEnd_toEndOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintStart_toStartOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintTop_toBottomOf="@+id/indicator_details_bottom_card_title_first"
                    style="@style/IndicatorDetailBottomCardDescription"/>
                <TextView
                    android:id="@+id/indicator_details_bottom_card_title_second"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/summary_moving_averages_title"
                    app:layout_constraintEnd_toEndOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintStart_toStartOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintTop_toBottomOf="@+id/indicator_details_bottom_card_details_first"
                    style="@style/IndicatorDetailBottomCardTitle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintStart_toStartOf="@+id/indicator_details_bottom_card_title_first"
                    app:layout_constraintTop_toBottomOf="@+id/indicator_details_bottom_card_title_second">
                    <TextView
                        android:id="@+id/indicator_details_bottom_card_description_second"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_moving_averages_list"
                        android:textDirection="locale"
                        style="@style/IndicatorDetailBottomCardDescription"/>
                    <TextView
                        android:id="@+id/indicator_details_bottom_card_description_third"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_moving_averages_text"
                        android:textDirection="locale"
                        style="@style/IndicatorDetailBottomCardDescription"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/indicator_details_card_bottom_separator"
            android:layout_width="0dp"
            android:layout_height="@dimen/indicator_details_bottom_spacer_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator_details_bottom_card"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
