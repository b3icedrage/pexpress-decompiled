<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/BottomSheetWithTabsContainer">
    <ImageView
        android:id="@+id/bottom_sheet_with_tabs_close_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close"
        android:layout_marginStart="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_with_tabs_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_sheet_with_tabs_title"/>
    <TextView
        android:gravity="center"
        android:id="@+id/bottom_sheet_with_tabs_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/margin_big_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bottom_sheet_with_tabs_close_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BottomSheetWithTabsTitle"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bottom_sheet_with_tabs_tab_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_sheet_with_tabs_title"
        style="@style/BottomSheetWithTabsTabLayout"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/bottom_sheet_with_tabs_view_pager"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_sheet_with_tabs_tab_container"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
