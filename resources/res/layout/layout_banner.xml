<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cookie"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/LayoutCookieRootContainer">
    <com.api.resources.VerticalTextView
        android:id="@+id/btn_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/LayoutCookieTextViewsContainer">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cookie_margin"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.api.resources.VerticalTextView
                android:layout_gravity="start"
                android:id="@+id/tv_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_cookie_text"
                style="@style/LayoutCookieMessage"/>
            <com.api.resources.VerticalTextView
                android:layout_gravity="start"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/LayoutCookieTitle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
