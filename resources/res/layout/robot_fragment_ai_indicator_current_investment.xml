<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ai_indicator_banner_background"
    android:padding="@dimen/ai_indicator_current_investment_padding_all"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ai_indicator_icon_image"
        android:layout_width="@dimen/ai_indicator_current_investment_icon_width"
        android:layout_height="@dimen/ai_indicator_current_investment_icon_height"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/ai_indicator_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/try_ai_indicator"
        android:layout_marginStart="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        android:layout_marginEnd="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/ai_indicator_arrow_image"
        app:layout_constraintStart_toEndOf="@+id/ai_indicator_icon_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotIndicatorsSummaryCurrentInvestmentTitle"/>
    <TextView
        android:id="@+id/ai_indicator_current_investment_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_indicator_current_investment_description_margin_top"
        android:text="@string/increase_your_autotrading_accuracy"
        android:layout_marginStart="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        android:layout_marginEnd="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/ai_indicator_arrow_image"
        app:layout_constraintStart_toEndOf="@+id/ai_indicator_icon_image"
        app:layout_constraintTop_toBottomOf="@+id/ai_indicator_title"
        style="@style/RobotIndicatorsSummaryDescription"/>
    <ImageView
        android:id="@+id/ai_indicator_arrow_image"
        android:background="@drawable/ic_right_arrow"
        android:layout_width="@dimen/big_icon_size"
        android:layout_height="@dimen/big_icon_size"
        android:layout_marginStart="@dimen/ai_indicator_current_investment_items_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
