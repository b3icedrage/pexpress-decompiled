<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BetWarningSwitchRootContainer">
    <TextView
        android:id="@+id/item_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bet_warning_switch_item_common_margin_vertical"
        android:layout_marginStart="@dimen/margin_item_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/item_lower_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BetWarningItemDescription"/>
    <TextView
        android:id="@+id/item_lower_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bet_warning_switch_item_common_margin_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_description"
        app:layout_constraintTop_toBottomOf="@+id/item_description"
        style="@style/BetWarningSwitchDescription"/>
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/item_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_item_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BetWarningSwitch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
