<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:background="@color/black"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/investmentPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerInvestmentAccount"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/accountSelectionPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerAccountOptions"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/optionsPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/assetsPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/indicatorPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerStrategiesRiskManagement"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/strategiesPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/riskManagementPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerRiskManagementFooter"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/realAccountActivationPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerRealAccountActivation"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/footerPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/dividerUnderFooter"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/separator_height"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/dividerUnderFooterBig"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/big_separator_height"
                android:alpha="0"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
