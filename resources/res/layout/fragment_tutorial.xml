<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_tutorial_tour_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/TutorialRootContainer">
    <ImageView
        android:id="@+id/tutorialBackButton"
        android:visibility="invisible"
        android:layout_width="@dimen/skipButtonWidth"
        android:layout_height="@dimen/skipButtonWidth"
        android:layout_marginStart="@dimen/skipButtonMargin"
        android:elevation="@dimen/tutorial_top_buttons_elevation"
        app:layout_constraintBottom_toBottomOf="@+id/tutorialSkipButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tutorialSkipButton"
        app:srcCompat="@drawable/ic_previous"/>
    <ImageView
        android:id="@+id/tutorialSkipButton"
        android:layout_width="@dimen/skipButtonWidth"
        android:layout_height="@dimen/skipButtonHeight"
        android:layout_margin="@dimen/skipButtonMargin"
        android:elevation="@dimen/tutorial_top_buttons_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorialPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tutorial_view_pager_margin_top"
        app:layout_constraintBottom_toTopOf="@+id/tutorialDotsIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tutorialSkipButton"/>
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/tutorialDotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tutorial_dots_indicator_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/next_on_boarding_screen_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TutorialDotsIndicator"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_on_boarding_screen_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/tutorial_button_next_margin_bottom"
        android:text="@string/next_text"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TutorialNextButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
