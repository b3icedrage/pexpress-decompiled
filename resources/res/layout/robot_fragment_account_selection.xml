<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_selection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotFragmentPartBlockContainer">
    <TextView
        android:id="@+id/account_selection_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_selection_title_margin_top"
        android:text="@string/bot_setting_account_selection"
        android:layout_marginStart="@dimen/account_selection_title_margin_start"
        android:layout_marginEnd="@dimen/account_selection_title_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/deposit_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotBlockTitle"/>
    <TextView
        android:id="@+id/deposit_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/deposit_text"
        android:layout_marginStart="@dimen/account_selection_title_margin_start"
        android:layout_marginEnd="@dimen/account_selection_title_margin_end"
        app:layout_constraintBottom_toBottomOf="@+id/account_selection_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/account_selection_title"
        style="@style/RobotDepositButtonTitle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/multiple_account_selection_switcher_container"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_selection_account_switcher_container_margin_top"
        android:layout_marginStart="@dimen/account_selection_account_switcher_container_margin_start"
        android:layout_marginEnd="@dimen/account_selection_account_switcher_container_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_selection_title"
        style="@style/RobotMultipleAccountSelectionBackground">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/account_icon"
            android:layout_width="@dimen/account_icon_width"
            android:layout_height="@dimen/account_icon_height"
            android:layout_marginStart="@dimen/account_icon_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/account_name_margin_top"
            android:layout_marginStart="@dimen/account_name_margin_start"
            app:layout_constraintStart_toEndOf="@+id/account_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotAccountSelectionTitle"/>
        <TextView
            android:id="@+id/account_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/account_balance_margin_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/account_name"
            app:layout_constraintTop_toBottomOf="@+id/account_name"
            style="@style/RobotAccountSelectionValue"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/multiple_account_value_shimmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/account_balance"
            app:layout_constraintEnd_toEndOf="@+id/account_balance"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/account_balance"
            app:layout_constraintTop_toTopOf="@+id/account_balance">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/account_value_shimmer"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/account_arrow_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_right_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/demo_account_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_selection_account_switcher_container_margin_top"
        android:layout_marginStart="@dimen/account_selection_account_switcher_container_margin_start"
        android:layout_marginEnd="@dimen/real_account_card_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/real_account_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_selection_title"
        layout="@layout/robot_fragment_account_selection_button"/>
    <include
        android:id="@+id/real_account_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_selection_account_switcher_container_margin_top"
        android:layout_marginStart="@dimen/real_account_card_margin_end"
        android:layout_marginEnd="@dimen/account_selection_account_switcher_container_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/demo_account_card"
        app:layout_constraintTop_toBottomOf="@+id/account_selection_title"
        layout="@layout/robot_fragment_account_selection_button"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/account_switcher_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="real_account_card,demo_account_card,multiple_account_selection_switcher_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
