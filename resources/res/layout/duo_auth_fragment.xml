<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/duoAuthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/duo_auth_motion_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/duo_auth_fragment_scene"
        style="@style/DuoAuthRootContainer">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/duo_auth_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duo_auth_back_button_margin_top"
            android:layout_marginStart="@dimen/duo_auth_back_button_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DuoAuthBackButton"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/duo_auth_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_duo_auth_logo"/>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/duo_auth_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/duo_auth_subtitle_margin_top"
            android:text="@string/duo_fa_tittle_text"
            app:layout_constraintEnd_toEndOf="@+id/duo_auth_icon"
            app:layout_constraintStart_toStartOf="@+id/duo_auth_icon"
            app:layout_constraintTop_toBottomOf="@+id/duo_auth_icon"
            style="@style/DuoAuthSubtitle"/>
        <com.google.android.material.textview.MaterialTextView
            android:gravity="center"
            android:id="@+id/duo_auth_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dou_auth_caption_margin_top"
            android:maxWidth="@dimen/duo_auth_text_caption_max_width"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/duo_auth_subtitle"
            app:layout_constraintStart_toStartOf="@+id/duo_auth_subtitle"
            app:layout_constraintTop_toBottomOf="@+id/duo_auth_subtitle"
            style="@style/DuoAuthCaption"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/duo_auth_text_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/dou_auth_caption_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/duo_auth_caption"
            style="@style/DuoAuthTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/duo_auth_edit_text"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/DuoAuthEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/duo_auth_verify_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/duo_auth_verify_button_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:text="@string/verify_text"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/duo_auth_text_input_layout"
            style="@style/LoginActionButton"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</FrameLayout>
