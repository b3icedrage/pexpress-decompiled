<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/icon_app"
        android:layout_width="@dimen/splash_icon_size"
        android:layout_height="@dimen/splash_icon_size"
        android:src="@drawable/ic_logo_transparent"
        app:layout_constraintBottom_toBottomOf="@+id/progress_layout"
        app:layout_constraintEnd_toEndOf="@+id/progress_layout"
        app:layout_constraintStart_toStartOf="@+id/progress_layout"
        app:layout_constraintTop_toTopOf="@+id/progress_layout"/>
    <ImageView
        android:id="@+id/progress_layout"
        android:layout_width="@dimen/hexagon_size"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3"
        app:srcCompat="@drawable/ic_progress_animated"/>
    <TextView
        android:id="@+id/progress_inner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_progress_text_top"
        app:layout_constraintEnd_toEndOf="@+id/progress_layout"
        app:layout_constraintStart_toStartOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/progress_layout"
        style="@style/LaunchAppPercent"/>
    <TextView
        android:id="@+id/title_launch_App"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/launch_app_title_margin_horizontal"
        android:layout_marginRight="@dimen/launch_app_title_margin_horizontal"
        android:layout_marginHorizontal="@dimen/launch_app_title_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7"
        style="@style/LaunchAppSubtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
