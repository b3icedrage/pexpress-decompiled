<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_card"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    style="@style/RobotMaterialCardButton.AccountSelection">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/account_selection_account_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/account_radio_button"
            android:layout_width="@dimen/real_account_radio_button_width"
            android:layout_height="@dimen/real_account_radio_button_width"
            android:layout_marginTop="@dimen/real_account_radio_button_margin_top"
            android:layout_marginBottom="@dimen/real_account_radio_button_margin_top"
            android:layout_marginStart="@dimen/real_account_radio_button_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotRadioButton.AccountSelection"/>
        <TextView
            android:id="@+id/account_selection_account_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/real_account_name_margin_top"
            android:layout_marginStart="@dimen/real_account_name_margin_start"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/account_radio_button"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotAccountSelectionTitle"/>
        <TextView
            android:id="@+id/account_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textDirection="firstStrong"
            android:layout_marginStart="@dimen/real_account_value_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/account_selection_account_title"
            app:layout_constraintStart_toStartOf="@+id/account_selection_account_title"
            app:layout_constraintTop_toBottomOf="@+id/account_selection_account_title"
            style="@style/RobotAccountSelectionValue"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/account_value_shimmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/account_shimmer_margin_top"
            app:layout_constraintBottom_toBottomOf="@+id/account_value"
            app:layout_constraintEnd_toEndOf="@+id/account_value"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/account_value"
            app:layout_constraintTop_toTopOf="@+id/account_value">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/account_value_shimmer"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
