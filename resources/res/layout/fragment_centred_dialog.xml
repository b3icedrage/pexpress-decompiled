<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/FullScreenDialogRootContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DialogIcon"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_title_top_transparent"
            android:layout_marginStart="@dimen/margin_title_horizontal"
            android:layout_marginEnd="@dimen/margin_title_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/FullScreenDialogTitle"/>
        <TextView
            android:textSize="@dimen/text_size_dialog_centred_subtitle"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_alert_dialog_subtitle_top"
            android:fontFamily="@font/roboto"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/margin_title_horizontal"
            android:layout_marginEnd="@dimen/margin_title_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/DialogSubtitle"/>
        <LinearLayout
            android:id="@+id/button_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_btn_top_centred"
            android:layout_marginStart="@dimen/margin_btn_horizontal"
            android:layout_marginEnd="@dimen/margin_btn_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@style/FullScreenDialogButtonsContainer">
            <Button
                android:id="@+id/passive_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/DialogPassiveButton"/>
            <Space
                android:id="@+id/spacer"
                android:layout_width="@dimen/space_between_btn"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/active_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <Button
                    android:id="@+id/active_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DialogActiveButton"/>
                <com.github.ybq.android.spinkit.SpinKitView
                    android:layout_gravity="center"
                    android:id="@+id/progress_circular"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/DialogSpinKitViewInButton"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
