<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ProfileRootContainer">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/profile_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.api.resources.CenteredToolbar
            android:id="@+id/profile_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/profile_tittle"
            style="@style/ProfileCenteredToolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/profile_nickname_input"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_nickname_input_height"
        android:layout_marginTop="@dimen/profile_nickname_input_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_app_bar"
        layout="@layout/profile_nickname_input"/>
    <include
        android:id="@+id/profile_input_error_label"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profile_input_error_label_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_nickname_input"
        layout="@layout/profile_input_error_label"/>
    <TextView
        android:id="@+id/profile_nickname_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/profile_nickname_label_margin_horizontal"
        android:layout_marginTop="@dimen/profile_nickname_label_margin_top"
        android:layout_marginRight="@dimen/profile_nickname_label_margin_horizontal"
        android:text="@string/nickname_description"
        android:layout_marginHorizontal="@dimen/profile_nickname_label_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_nickname_input"
        style="@style/ProfileNicknameLabel"/>
    <include
        android:id="@+id/profile_info_id"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_info_entry_height_common"
        android:layout_marginTop="@dimen/profile_info_id_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_nickname_label"
        layout="@layout/profile_info_entry"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_info_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_id"
        style="@style/ProfileInfoEntrySeparator"/>
    <include
        android:id="@+id/profile_info_email"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_info_entry_height_common"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_id"
        layout="@layout/profile_info_entry"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/profile_info_country"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_email"
        style="@style/ProfileInfoEntrySeparator"/>
    <include
        android:id="@+id/profile_info_country"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_info_entry_height_common"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_email"
        layout="@layout/profile_info_entry"/>
    <TextView
        android:id="@+id/profile_verification_text"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_info_entry_height_common"
        android:layout_marginTop="@dimen/profile_verification_text_margin_top"
        android:text="@string/verification_account_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_country"
        style="@style/ProfileAccountVerificationTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
