<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/stub_onboarding_item_image_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/stub_onboarding_item_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/stub_onboarding_item_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toTopOf="@+id/stub_onboarding_item_view_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StubOnboardingTitle"/>
    <View
        android:id="@+id/stub_onboarding_item_view_spacer"
        android:layout_width="0dp"
        android:layout_height="@dimen/stub_onboarding_item_view_spacer_height"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/margin_big_medium"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toTopOf="@+id/stub_onboarding_item_bottom_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StubOnboardingItemSpacerStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stub_onboarding_item_bottom_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/margin_small_medium"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/stub_onboarding_item_bottom_info_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/you_also_get_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StubOnboardingSubtitle"/>
        <ImageView
            android:id="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_big_medium"
            android:src="@drawable/ic_accept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stub_onboarding_item_bottom_info_subtitle"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/training_on_demo_text"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_1"
            app:layout_constraintTop_toTopOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_1"
            style="@style/StubOnboardingAcceptanceText"/>
        <ImageView
            android:id="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:src="@drawable/ic_accept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_1"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/instructions_text"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_2"
            app:layout_constraintTop_toTopOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_2"
            style="@style/StubOnboardingAcceptanceText"/>
        <ImageView
            android:id="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:src="@drawable/ic_accept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_2"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_tour_page_4_title"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_3"
            app:layout_constraintTop_toTopOf="@+id/stub_onboarding_item_bottom_info_subtitle_acceptIcon_3"
            style="@style/StubOnboardingAcceptanceText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
