<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/IssueCategoryPartContainer">
    <TextView
        android:ellipsize="end"
        android:id="@+id/issue_categories_part_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/issue_categories_title_margin_top"
        android:text="@string/_hoose_issue_category_res_0x7f130493"
        android:layout_marginStart="@dimen/common_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/view_all_text"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/IssueCategoryPartTitle"/>
    <TextView
        android:id="@+id/view_all_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_all_text"
        android:layout_marginStart="@dimen/view_all_margin_start"
        android:layout_marginEnd="@dimen/common_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/issue_categories_part_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/issue_categories_part_title"
        app:layout_constraintTop_toTopOf="@+id/issue_categories_part_title"
        style="@style/IssueCategoryViewAllText"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/issue_categories_recycler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_all_text"
        app:layout_constraintStart_toStartOf="@+id/issue_categories_part_title"
        app:layout_constraintTop_toBottomOf="@+id/issue_categories_part_title"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/categories_list_shimmer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/issue_category_items_space"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/issue_categories_part_title">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_issue_categories_shimmer"
            android:scaleType="fitXY"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
