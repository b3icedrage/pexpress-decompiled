<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BottomSheetDialogRootContainer">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_close_view"
                android:src="@drawable/ic_bet_warning_close"
                app:layout_constraintBottom_toTopOf="@+id/trading_strategies_selection_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/trading_strategies_selection_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/trading_strategies_selection_button"
                layout="@layout/strategy_selection_bottom_sheet_page"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/trading_strategies_selection_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/common_outer_margin"
                android:layout_marginRight="@dimen/common_outer_margin"
                android:layout_marginBottom="@dimen/common_outer_margin"
                android:text="@string/select_text"
                android:layout_marginHorizontal="@dimen/common_outer_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/trading_strategies_selection_view"
                app:layout_constraintStart_toStartOf="@+id/trading_strategies_selection_view"
                style="@style/StrategySelectionButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/trading_strategies_activation_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/common_outer_margin"
                android:layout_marginRight="@dimen/common_outer_margin"
                android:layout_marginBottom="@dimen/common_outer_margin"
                android:text="@string/unlock_btn"
                android:layout_marginHorizontal="@dimen/common_outer_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/trading_strategies_selection_view"
                app:layout_constraintStart_toStartOf="@+id/trading_strategies_selection_view"
                style="@style/StrategyActivationButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
