<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ChangeLanguageRootContainer">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/fragment_change_language_app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.api.resources.CenteredToolbar
            android:id="@+id/fragment_change_language_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:title="@string/language_text"
            style="@style/ChangeLanguageToolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fragment_change_language_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragment_change_language_app_bar_layout"
        style="@style/ChangeLanguageRecyclerView"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fragment_change_save_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/margin_btn_next_bottom"
        android:text="@string/save_changes_text"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ChangeLanguageActionButton"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/change_language_action_button_base_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ChangeLanguageActionButtonBase"/>
</androidx.constraintlayout.widget.ConstraintLayout>
