<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trading_strategies"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotFragmentPartBlockContainer">
    <TextView
        android:id="@+id/risk_management_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/risk_management_title_margin_top"
        android:text="@string/risk_management_title"
        android:layout_marginStart="@dimen/common_outer_margin"
        app:layout_constraintEnd_toStartOf="@+id/risk_management_help_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotProfitLimitTitle"/>
    <ImageView
        android:id="@+id/risk_management_help_icon"
        android:padding="@dimen/risk_management_help_icon_padding"
        android:layout_width="@dimen/risk_management_help_icon_size"
        android:layout_height="@dimen/risk_management_help_icon_size"
        android:src="@drawable/ic_question_icon"
        app:layout_constraintBottom_toBottomOf="@+id/risk_management_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/risk_management_title"/>
    <TextView
        android:id="@+id/maximum_profit_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/risk_management_title_margin_top"
        android:text="@string/strategy_text"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_management_title"
        style="@style/RobotCommonSubsectionTitle"/>
    <include
        android:id="@+id/robot_trading_strategy_selection_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maximum_profit_sub_title"
        layout="@layout/trading_strategy_inner_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
