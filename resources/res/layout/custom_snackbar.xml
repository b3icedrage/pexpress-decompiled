<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/snackbar_icon"
        android:layout_width="@dimen/snackbar_icon"
        android:layout_height="@dimen/snackbar_icon"
        android:layout_marginTop="@dimen/snackbar_icon_margin_vertical"
        android:layout_marginBottom="@dimen/snackbar_icon_margin_vertical"
        android:layout_marginStart="@dimen/snackbar_icon_margin_start"
        android:layout_marginVertical="@dimen/snackbar_icon_margin_vertical"/>
    <TextView
        android:id="@+id/snackbar_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/snackbar_text_margin_vertical"
        android:layout_marginBottom="@dimen/snackbar_text_margin_vertical"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/snackbar_text_margin_start"
        android:layout_marginEnd="@dimen/snackbar_text_margin_start"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/snackbar_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/snackbar_button_margin_end"
        style="@style/CustomSnackbarTextButton"/>
</LinearLayout>
