<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ChatWithSupportSurfaceContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/crisp_chat_with_support_surface_image_container"
            android:background="@color/primary"
            android:layout_width="@dimen/chat_with_support_image_container_width"
            android:layout_height="@dimen/chat_with_support_image_container_height"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:src="@drawable/ic_support"
            android:layout_marginStart="@dimen/common_outer_margin"
            android:layout_marginVertical="@dimen/common_outer_margin"
            app:contentPadding="@dimen/crisp_chat_with_support_surface_image_container_content_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ChatWithSupportSurfaceImageShape"/>
        <ImageView
            android:background="@drawable/ic_green_circle"
            android:padding="@dimen/crisp_chat_with_support_surface_image_container_circel_padding"
            android:layout_width="@dimen/crisp_chat_with_support_surface_image_container_circel_size"
            android:layout_height="@dimen/crisp_chat_with_support_surface_image_container_circel_size"
            android:src="@drawable/ic_green_circle"
            app:backgroundTint="@color/background"
            app:layout_constraintBottom_toBottomOf="@+id/crisp_chat_with_support_surface_image_container"
            app:layout_constraintEnd_toEndOf="@+id/crisp_chat_with_support_surface_image_container"
            app:tint="@color/secondary"/>
        <TextView
            android:id="@+id/crisp_chat_with_support_surface_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chat_with_support_surface_title_margin_top"
            android:text="@string/chat_with_support_title"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintEnd_toStartOf="@+id/crisp_chat_with_support_surface_counter"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/crisp_chat_with_support_surface_image_container"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ChatWithSupportSurfaceTitle"/>
        <TextView
            android:id="@+id/crisp_chat_with_support_surface_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/chat_with_support_surface_caption_margin_bottom"
            android:text="@string/chat_with_support_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/crisp_chat_with_support_surface_title"
            app:layout_constraintTop_toBottomOf="@+id/crisp_chat_with_support_surface_title"
            style="@style/ChatWithSupportSurfaceCaption"/>
        <ImageView
            android:id="@+id/crisp_chat_with_support_surface_counter"
            android:background="@drawable/message_counter_bg"
            android:layout_width="@dimen/crisp_chat_with_support_surface_counter_height"
            android:layout_height="@dimen/crisp_chat_with_support_surface_counter_height"
            android:layout_marginTop="@dimen/crisp_chat_with_support_surface_counter_margin_top"
            android:text=""
            android:layout_marginStart="@dimen/crisp_chat_with_support_surface_counter_margin_top"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/crisp_chat_with_support_surface_title"
            app:layout_constraintTop_toTopOf="@+id/crisp_chat_with_support_surface_title"/>
        <TextView
            android:id="@+id/indicator"
            android:background="@drawable/chat_indicator_background"
            android:layout_width="@dimen/chat_indicator_size"
            android:layout_height="@dimen/chat_indicator_size"
            android:layout_marginBottom="@dimen/chat_indicator_bottom_margin"
            android:layout_marginEnd="@dimen/chat_indicator_end_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/ChatIndicator"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
