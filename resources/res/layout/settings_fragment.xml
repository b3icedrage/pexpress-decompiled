<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.api.resources.CenteredToolbar
            android:id="@+id/centered_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:title="@string/settings_text"
            style="@style/SettingsCenteredToolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:background="@color/black"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_container"
            android:background="@color/background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/trading_param_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_middle_margin_vertical"
                android:text="@string/trading_text"
                android:layout_marginStart="@dimen/layout_common_margin_horizontal"
                android:layout_marginEnd="@dimen/layout_common_margin_horizontal"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SettingsTradingTitle"/>
            <include
                android:id="@+id/one_click_deal_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_common_margin_vertical"
                android:layout_marginStart="@dimen/layout_common_margin_horizontal"
                android:layout_marginEnd="@dimen/layout_common_margin_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trading_param_header"
                layout="@layout/title_with_switch"/>
            <include
                android:id="@+id/one_click_stop_robot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_common_margin_vertical"
                android:layout_marginStart="@dimen/layout_common_margin_horizontal"
                android:layout_marginEnd="@dimen/layout_common_margin_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/one_click_deal_view"
                layout="@layout/title_with_switch"/>
            <View
                android:id="@+id/background_block_1"
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/layout_big_margin_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/one_click_stop_robot"
                style="@style/SettingsSeparatorView"/>
            <TextView
                android:id="@+id/language_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_middle_margin_vertical"
                android:text="@string/language_text"
                android:layout_marginStart="@dimen/layout_common_margin_horizontal"
                android:layout_marginEnd="@dimen/layout_common_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/background_block_1"
                style="@style/SettingsLanguageTitle"/>
            <include
                android:id="@+id/change_language_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_item_switch_height"
                android:layout_marginLeft="@dimen/settings_common_margin_horizontal"
                android:layout_marginTop="@dimen/layout_common_margin_vertical"
                android:layout_marginRight="@dimen/settings_common_margin_horizontal"
                android:layout_marginBottom="@dimen/layout_middle_margin_vertical"
                android:layout_marginHorizontal="@dimen/settings_common_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/language_header"
                app:layout_constraintVertical_bias="0"
                layout="@layout/item_language_btn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
