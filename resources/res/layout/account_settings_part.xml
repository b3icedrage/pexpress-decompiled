<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/accountBlockBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/account_settings_profile_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginTop="@dimen/account_settings_profile_button_margin_top"
        android:layout_marginRight="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginHorizontal="@dimen/account_settings_common_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/account_button"/>
    <include
        android:id="@+id/account_settings_settings_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginTop="@dimen/account_settings_settings_button_margin_top"
        android:layout_marginRight="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginHorizontal="@dimen/account_settings_common_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/in_app_review_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_settings_profile_button"
        app:layout_goneMarginBottom="@dimen/account_settings_settings_button_margin_bottom"
        layout="@layout/account_button"/>
    <include
        android:id="@+id/in_app_review_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginTop="@dimen/account_settings_settings_button_margin_top"
        android:layout_marginRight="@dimen/account_settings_common_margin_horizontal"
        android:layout_marginBottom="@dimen/account_settings_settings_button_margin_bottom"
        android:layout_marginHorizontal="@dimen/account_settings_common_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_settings_settings_button"
        layout="@layout/rate_us_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
