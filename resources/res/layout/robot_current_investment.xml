<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:paddingBottom="@dimen/investment_separator_margin_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/investment_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/investment_titile_margin_top"
        android:text="@string/robot_current_investiment_text"
        android:layout_marginStart="@dimen/title_margin_start"
        android:layout_marginEnd="@dimen/title_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotCurrentInvestmentTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/investment_card_margin_top"
        android:layout_marginStart="@dimen/investment_card_margin_start"
        android:layout_marginEnd="@dimen/investment_card_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/investment_title"
        style="@style/RobotCurrentInvestmentContainerMaterialCardView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/current_investment_card_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/investment_mock_view_to_add_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/investment_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/investment_account_type_margin"
                android:text="@string/main_robot_demo_account_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotCurrentInvestmentAccountType"/>
            <TextView
                android:gravity="center"
                android:id="@+id/investment_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/investment_balance_common_margin"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotCurrentInvestmentHeaderBalance"/>
            <TextView
                android:id="@+id/trade_change_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profit_text"
                app:layout_constraintStart_toStartOf="@+id/investment_balance"
                app:layout_constraintTop_toBottomOf="@+id/investment_balance"
                style="@style/RobotCurrentInvestmentProfitIntTitleTitle"/>
            <TextView
                android:id="@+id/trade_change_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/robot_current_investment_trade_change_text_margin_start"
                app:layout_constraintBaseline_toBaselineOf="@+id/trade_change_title"
                app:layout_constraintStart_toEndOf="@+id/trade_change_title"
                style="@style/RobotCurrentInvestmentProfitInTitle"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/investment_account_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="investment_account_type, trade_change_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/chart_placeholder_shimmer"
                android:layout_width="0dp"
                android:layout_height="@dimen/investment_graphic_height"
                android:layout_marginTop="@dimen/investment_account_barrier_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/investment_account_barrier"
                app:shimmer_clip_to_children="true">
                <ImageView
                    android:id="@+id/chart_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/robot_current_investment_trading_loading_indicator_shimmer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="@+id/progress_layout"
                app:layout_constraintStart_toStartOf="@+id/progress_layout"
                app:layout_constraintTop_toTopOf="@+id/progress_layout"
                app:shimmer_clip_to_children="true">
                <ImageView
                    android:id="@+id/robot_current_investment_trading_loading_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <include
                android:id="@+id/progress_layout"
                android:visibility="invisible"
                android:layout_width="@dimen/progress_layout_height"
                android:layout_height="@dimen/progress_layout_height"
                android:layout_marginTop="@dimen/investment_card_common_margin_top"
                android:layout_marginStart="@dimen/common_outer_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chart_placeholder_shimmer"
                layout="@layout/hexagon_progress_bold_small"/>
            <TextView
                android:id="@+id/timer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="@+id/progress_layout"
                app:layout_constraintStart_toStartOf="@+id/progress_layout"
                app:layout_constraintTop_toTopOf="@+id/progress_layout"
                style="@style/RobotCurrentInvestmentTimer"/>
            <ImageView
                android:id="@+id/progress_layout_signals"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="@+id/progress_layout"
                app:layout_constraintStart_toStartOf="@+id/progress_layout"
                app:layout_constraintTop_toTopOf="@+id/progress_layout"/>
            <ImageView
                android:id="@+id/signals_icon_in_progress"
                android:visibility="gone"
                android:layout_width="@dimen/width_icon_signals_in_progress"
                android:layout_height="@dimen/height_icon_signals_in_progress"
                app:layout_constraintBottom_toBottomOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="@+id/progress_layout"
                app:layout_constraintStart_toStartOf="@+id/progress_layout"
                app:layout_constraintTop_toTopOf="@+id/progress_layout"/>
            <ImageView
                android:id="@+id/investment_asset_icon"
                android:layout_width="@dimen/asset_icon_size_current_investment"
                android:layout_height="@dimen/asset_icon_size_current_investment"
                android:layout_marginTop="@dimen/current_investment_asset_icon_margin_top"
                android:layout_marginStart="@dimen/margin_start_trading_asset_title"
                app:layout_constraintStart_toEndOf="@+id/progress_layout"
                app:layout_constraintTop_toTopOf="@+id/progress_layout"/>
            <TextView
                android:id="@+id/trading_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/selected_indicator_text"
                app:layout_constraintStart_toStartOf="@+id/investment_asset_icon"
                app:layout_constraintTop_toBottomOf="@+id/investment_asset_name"
                style="@style/RobotCurrentInvestmentAssetTitle"/>
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/investment_asset_icon_placeholder_shimmer"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/investment_asset_icon"
                app:layout_constraintEnd_toEndOf="@+id/investment_asset_icon"
                app:layout_constraintStart_toStartOf="@+id/investment_asset_icon"
                app:layout_constraintTop_toTopOf="@+id/investment_asset_icon"
                app:shimmer_clip_to_children="true">
                <ImageView
                    android:id="@+id/investment_asset_icon_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <TextView
                android:id="@+id/investment_asset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/investment_minimum_textviews_spacing"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/investment_asset_icon"
                app:layout_constraintEnd_toStartOf="@+id/investment_asset_percents"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/investment_asset_icon"
                app:layout_constraintTop_toTopOf="@+id/investment_asset_icon"
                style="@style/RobotCurrentInvestmentAssetName"/>
            <TextView
                android:id="@+id/investment_asset_percents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/investment_percents_horizontal_margin_little"
                android:layout_marginEnd="@dimen/investment_percents_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="@+id/investment_asset_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/investment_asset_name"
                app:layout_constraintTop_toTopOf="@+id/investment_asset_name"
                style="@style/RobotCurrentInvestmentAssetPercentValue"/>
            <TextView
                android:id="@+id/searching_by_signals_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/searching_for_signals_text"
                android:layout_marginEnd="@dimen/robo_current_investment_searching_by_signals_text_margin_end"
                app:layout_constraintBottom_toBottomOf="@+id/investment_asset_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/investment_asset_name"
                app:layout_constraintTop_toTopOf="@+id/investment_asset_name"
                style="@style/RobotCurrentInvestmentSearchingForSignalsTitle"/>
            <View
                android:id="@+id/investment_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/investment_separator_height"
                android:layout_marginStart="@dimen/progress_bar_margin_end"
                android:layout_marginEnd="@dimen/progress_bar_margin_end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress_layout"
                style="@style/RobotCurrentInvestmentSeparator"/>
            <include
                android:id="@+id/robot_current_investment_ai_indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/common_outer_margin"
                android:layout_marginTop="@dimen/investment_amount_title_margin_top"
                android:layout_marginRight="@dimen/common_outer_margin"
                android:layout_marginHorizontal="@dimen/common_outer_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress_layout"
                layout="@layout/robot_fragment_ai_indicator_current_investment"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/indicators_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="robot_current_investment_ai_indicator"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/robot_current_investment_item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/robot_current_investment_item_container_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/indicators_barrier">
                <include
                    android:id="@+id/robot_current_investment_amount_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/investment_item_common_margin"
                    android:layout_marginEnd="@dimen/investment_item_common_margin"
                    app:layout_constraintBottom_toTopOf="@+id/robot_current_investment_profit_item"
                    app:layout_constraintEnd_toStartOf="@+id/robot_current_investment_strategy_top_right_placed_item"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/robot_current_investment_setting_item"/>
                <include
                    android:id="@+id/robot_current_investment_strategy_top_right_placed_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/investment_item_common_margin"
                    android:layout_marginStart="@dimen/investment_item_common_margin"
                    app:layout_constraintBottom_toTopOf="@+id/robot_current_investment_loss_limit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/robot_current_investment_amount_item"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/robot_current_investment_setting_item"/>
                <include
                    android:id="@+id/robot_current_investment_profit_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/investment_item_common_margin"
                    android:layout_marginEnd="@dimen/investment_item_common_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/robot_current_investment_loss_limit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/robot_current_investment_amount_item"
                    layout="@layout/robot_current_investment_setting_item"/>
                <include
                    android:id="@+id/robot_current_investment_loss_limit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/investment_item_common_margin"
                    android:layout_marginStart="@dimen/investment_item_common_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/robot_current_investment_profit_item"
                    app:layout_constraintTop_toBottomOf="@+id/robot_current_investment_strategy_top_right_placed_item"
                    layout="@layout/robot_current_investment_setting_item"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/robot_current_investment_linear_item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/robot_current_investment_item_container_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/indicators_barrier">
                <include
                    android:id="@+id/robot_current_investment_linear_amount_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/robot_current_investment_linear_setting_item"/>
                <View
                    android:id="@+id/robot_current_investment_linear_strategy_item_separator"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/robot_current_investment_linear_settings_item_separator_height"
                    style="@style/RobotCurrentInvestmentLinearSettingsItemSeparator"/>
                <include
                    android:id="@+id/robot_current_investment_linear_strategy_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/robot_current_investment_linear_settings_item_margin_top"
                    layout="@layout/robot_current_investment_linear_setting_item"/>
                <View
                    android:id="@+id/robot_current_investment_linear_profit_item_separator"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/robot_current_investment_linear_settings_item_separator_height"
                    style="@style/RobotCurrentInvestmentLinearSettingsItemSeparator"/>
                <include
                    android:id="@+id/robot_current_investment_linear_profit_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/robot_current_investment_linear_settings_item_margin_top"
                    layout="@layout/robot_current_investment_linear_setting_item"/>
                <View
                    android:id="@+id/robot_current_investment_linear_loss_item_separator"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/robot_current_investment_linear_settings_item_separator_height"
                    style="@style/RobotCurrentInvestmentLinearSettingsItemSeparator"/>
                <include
                    android:id="@+id/robot_current_investment_linear_loss_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/robot_current_investment_linear_settings_item_margin_top"
                    layout="@layout/robot_current_investment_linear_setting_item"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_on_chart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/show_on_chart_margin_top"
        android:text="@string/btn_show_chart_text"
        android:layout_marginEnd="@dimen/show_on_chart_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/stop_the_robot"
        app:layout_constraintStart_toStartOf="@+id/materialCardView"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView"
        style="@style/RobotCurrentInvestmentShowOnChartActionButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stop_the_robot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stop_the_robot_text"
        android:layout_marginStart="@dimen/stop_the_robot_margin_start"
        app:layout_constraintEnd_toEndOf="@+id/materialCardView"
        app:layout_constraintStart_toEndOf="@+id/show_on_chart"
        app:layout_constraintTop_toTopOf="@+id/show_on_chart"
        style="@style/RobotCurrentInvestmentStopTheRobotActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
