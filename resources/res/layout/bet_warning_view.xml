<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BetWarningRootContainer">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_close_view"
        android:src="@drawable/ic_bet_warning_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/title_image"
        android:layout_width="@dimen/size_image_bet_warning"
        android:layout_height="@dimen/size_image_bet_warning"
        android:layout_marginTop="@dimen/margin_title_image_bet_warning_top"
        android:layout_marginStart="@dimen/margin_title_image_bet_warning_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BetWarningTitleImage"/>
    <TextView
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_title_bet_warning_start"
        android:layout_marginEnd="@dimen/btn_bet_warning_margin"
        app:layout_constraintBottom_toBottomOf="@+id/title_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_image"
        app:layout_constraintTop_toTopOf="@+id/title_image"
        style="@style/BetWarningTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bet_warning_values_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/first_item_bet_warning_margin_top"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_image"
        style="@style/BetWarningValueContainerMaterialCardView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/amount_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_item_bet_warning"
                app:layout_constraintTop_toBottomOf="@+id/title_image"
                layout="@layout/bet_warning_description_item"/>
            <include
                android:id="@+id/time_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_item_bet_warning"
                layout="@layout/bet_warning_description_item"/>
            <include
                android:id="@+id/strategy_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_item_bet_warning"
                layout="@layout/bet_warning_description_item"/>
            <include
                android:id="@+id/indicator_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_item_bet_warning"
                layout="@layout/bet_warning_description_item"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/one_click_deals_view_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/btn_bet_warning_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet_warning_values_container"
        style="@style/BetWarningValueContainerMaterialCardView">
        <include
            android:id="@+id/one_click_deals_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/bet_warning_values_container"
            layout="@layout/bet_warning_switch_item"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/btn_bet_warning_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/btn_bet_warning_margin_bottom"
        android:text="@string/confirm_text"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/one_click_deals_view_container"
        style="@style/BetWarningActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
