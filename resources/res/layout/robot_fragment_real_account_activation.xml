<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/real_account_disable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotRealAccountActivationPartBlockContainer">
    <ImageView
        android:id="@+id/unavailable_trading_image"
        android:layout_width="@dimen/unavailable_trading_image_side"
        android:layout_height="@dimen/unavailable_trading_image_side"
        android:layout_marginTop="@dimen/unavailable_trading_image_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/unavailable_trading_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/unavailable_trading_title_text_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unavailable_trading_image"
        style="@style/RobotBlockTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/unavailable_trading_description_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/unavailable_trading_description_text_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/unavailable_trading_text"
        app:layout_constraintStart_toStartOf="@+id/unavailable_trading_text"
        app:layout_constraintTop_toBottomOf="@+id/unavailable_trading_text"
        style="@style/RobotStrategySelectionDescription"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/robot_account_activation_card_margin_top"
        android:layout_marginBottom="@dimen/robot_real_account_activation_steps_container_margin_bottom"
        android:layout_marginStart="@dimen/robot_account_activation_card_margin_side"
        android:layout_marginEnd="@dimen/robot_account_activation_card_margin_side"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unavailable_trading_description_text"
        style="@style/RobotMaterialCardView.Step">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/inclusion_step_first_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/item_step"/>
            <View
                android:id="@+id/robot_activation_status_card_separator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/robot_account_activation_horizontal_separator_height"
                android:layout_marginLeft="@dimen/common_outer_margin"
                android:layout_marginRight="@dimen/common_outer_margin"
                android:layout_marginHorizontal="@dimen/common_outer_margin"
                style="@style/RobotCardSeparator"/>
            <include
                android:id="@+id/inclusion_step_second_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/item_step"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
