<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/CaptchaRootContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/captcha_fragment_web_view_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CaptchaWebViewContainer">
        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/commonProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ForgotPasswordSpinKitView"/>
        <WebView
            android:layout_gravity="center"
            android:id="@+id/captcha_fragment_web_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/error_block"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dialog_common_subtitle_margin_top"
                android:layout_marginTop="@dimen/dialog_common_subtitle_margin_top"
                android:layout_marginRight="@dimen/dialog_common_subtitle_margin_top"
                android:layout_marginHorizontal="@dimen/dialog_common_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DialogSubtitle"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/active_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dialog_common_subtitle_margin_top"
                android:text="@string/refresh_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/error_text"
                style="@style/DialogActiveButton"/>
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/loadingProgressBar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/active_btn"
                app:layout_constraintEnd_toEndOf="@+id/active_btn"
                app:layout_constraintStart_toStartOf="@+id/active_btn"
                app:layout_constraintTop_toTopOf="@+id/active_btn"
                style="@style/ForgotPasswordSpinKitView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
