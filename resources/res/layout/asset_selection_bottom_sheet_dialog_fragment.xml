<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/RobotBottomSheetRootContainer">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/item_switch_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/fragment_assets_scene">
        <ImageView
            android:id="@+id/assets_selection_close_button"
            android:padding="@dimen/assets_selection_close_button_padding"
            android:layout_width="@dimen/assets_selection_close_button_size"
            android:layout_height="@dimen/assets_selection_close_button_size"
            android:src="@drawable/ic_close"/>
        <TextView
            android:id="@+id/assets_selection_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bot_settings_trading_assets"
            style="@style/BottomSheetWithRecyclerTitle"/>
        <View
            android:id="@+id/divider_header_asset"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_separator_height"
            style="@style/AssetSelectionDivider"/>
        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/auto_selection_asset_text"
            style="@style/AssetSelectionTitle"/>
        <TextView
            android:id="@+id/item_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/auto_selection_asset_description_text"
            style="@style/AssetSelectionDescription"/>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AssetSelectionSwitch"/>
        <View
            android:id="@+id/divider_recycler_asset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_separator_height"
            android:layout_marginTop="@dimen/item_margin_text_vertical"
            style="@style/AssetSelectionDivider"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:paddingBottom="@dimen/trading_asset_recycler_padding_bottom"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_recycler_asset"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</FrameLayout>
