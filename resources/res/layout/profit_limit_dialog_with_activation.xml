<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profit_limit_with_activation_dialog_motion_layout"
    android:paddingLeft="@dimen/common_outer_margin"
    android:paddingRight="@dimen/common_outer_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/common_outer_margin"
    app:layoutDescription="@xml/profit_limit_dialog_with_activation_scene"
    style="@style/BottomSheetDialogRootContainer">
    <ImageView
        android:id="@+id/profit_limit_with_activation_dialog_bet_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_close_view"
        android:src="@drawable/ic_bet_warning_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/profit_limit_with_activation_dialog_cup"
        android:layout_width="@dimen/profit_limit_dialog_cup_size"
        android:layout_height="@dimen/profit_limit_dialog_cup_size"
        android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_cup_margin_top"
        android:layout_marginEnd="@dimen/profit_limit_with_activation_dialog_cup_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_bet_warning"
        style="@style/ProfitLimitCommonImageView"/>
    <TextView
        android:id="@+id/profit_limit_with_activation_dialog_infinity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/infinity_sign"
        style="@style/ProfitLimitWithActivationInfinitySign"/>
    <ProgressBar
        android:id="@+id/profit_limit_with_activation_dialog_progress_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/profit_limit_with_activation_dialog_progress_bar_height"
        android:max="10000"
        style="@style/ProfitLimitWithActivationProgressBar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/profit_limit_with_activation_dialog_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/profit_limit_with_activation_dialog_moving_cup"
        android:layout_width="@dimen/profit_limit_with_activation_dialog_moving_cup_width"
        android:layout_height="@dimen/profit_limit_with_activation_dialog_moving_cup_height"
        app:layout_constraintBottom_toTopOf="@+id/profit_limit_with_activation_dialog_progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_guideline"
        app:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_guideline"
        style="@style/ProfitLimitCommonImageView"/>
    <TextView
        android:id="@+id/profit_limit_with_activation_dialog_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/ProfitLimitWithActivationAmount"/>
    <TextView
        android:id="@+id/profit_limit_with_activation_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_title_margin_top"
        android:text="@string/you_have_reached_profit_title"
        app:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_progress_bar"
        app:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_infinity"
        style="@style/ProfitLimitWithActivationDialogTitle"/>
    <TextView
        android:id="@+id/profit_limit_with_activation_dialog_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_description_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/profit_limit_with_activation_dialog_title"
        app:layout_constraintStart_toStartOf="@+id/profit_limit_with_activation_dialog_title"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_title"
        style="@style/ProfitLimitWithActivationDialogDescription"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profit_limit_with_activation_dialog_passive_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_passive_button_margin_top"
        android:layout_marginBottom="@dimen/profit_limit_with_activation_dialog_passive_button_margin_bottom"
        android:text="@string/later_btn_text"
        android:layout_marginEnd="@dimen/profit_limit_with_activation_dialog_buttons_margin_half"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/profit_limit_with_activation_dialog_active_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_with_activation_dialog_description"
        style="@style/ProfitLimitWithActivationPassiveButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profit_limit_with_activation_dialog_active_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/activate_text"
        android:layout_marginStart="@dimen/profit_limit_with_activation_dialog_buttons_margin_half"
        app:layout_constraintBottom_toBottomOf="@+id/profit_limit_with_activation_dialog_passive_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profit_limit_with_activation_dialog_passive_button"
        app:layout_constraintTop_toTopOf="@+id/profit_limit_with_activation_dialog_passive_button"
        style="@style/ProfitLimitWithActivationActiveButton"/>
</androidx.constraintlayout.motion.widget.MotionLayout>
