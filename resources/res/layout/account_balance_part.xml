<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/accountBlockBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/account_balance_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_balance_title_margin_top"
        android:text="@string/balance_tittle"
        android:layout_marginStart="@dimen/account_balance_title_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AccountBalanceTitle"/>
    <TextView
        android:id="@+id/account_balance_balance_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_balance_balance_margin_top"
        android:layout_marginEnd="@dimen/account_balance_balance_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AccountBalanceValue"/>
    <include
        android:id="@+id/account_balance_deposit_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_balance_common_margin_horizontal"
        android:layout_marginTop="@dimen/account_balance_deposit_button_margin_top"
        android:layout_marginRight="@dimen/account_balance_common_margin_horizontal"
        android:layout_marginHorizontal="@dimen/account_balance_common_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_balance_title_text"
        layout="@layout/account_button"/>
    <include
        android:id="@+id/account_balance_withdraw_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_balance_common_margin_horizontal"
        android:layout_marginTop="@dimen/account_balance_withdraw_button_margin_top"
        android:layout_marginRight="@dimen/account_balance_common_margin_horizontal"
        android:layout_marginBottom="@dimen/account_balance_withdraw_button_margin_bottom"
        android:layout_marginHorizontal="@dimen/account_balance_common_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_balance_deposit_button"
        layout="@layout/account_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
