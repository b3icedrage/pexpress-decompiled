<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/strategy_card"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    style="@style/RobotMaterialCardButton.StrategySelection">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trading_strategies_strategy_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/strategy_radio_button"
            android:layout_width="@dimen/trading_strategies_optimal_strategy_layout_width"
            android:layout_height="@dimen/trading_strategies_optimal_strategy_layout_width"
            android:layout_marginTop="@dimen/trading_strategies_optimal_strategy_layout_margin_top"
            android:layout_marginStart="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotRadioButton.StrategySelection"/>
        <TextView
            android:id="@+id/trading_strategies_strategy_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            android:layout_marginTop="@dimen/trading_strategies_optimal_strategy_value_margin_top"
            android:layout_marginRight="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            android:layout_marginHorizontal="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/strategy_radio_button"
            style="@style/RobotStrategySelectionTitle"/>
        <TextView
            android:id="@+id/trading_strategies_strategy_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            android:layout_marginTop="@dimen/trading_strategies_optimal_strategy_title_margin_top"
            android:layout_marginRight="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            android:layout_marginBottom="@dimen/strategy_text_margin_bottom"
            android:layout_marginHorizontal="@dimen/trading_strategies_optimal_strategy_layout_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trading_strategies_strategy_title"
            app:layout_constraintVertical_bias="0"
            style="@style/RobotStrategySelectionDescription"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
