<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/settings_item_switch_height"
    style="@style/SettingsLanguageButton">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_horizontal_item_settings"
        android:layout_marginEnd="@dimen/margin_horizontal_next_icon">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/lang_icon"
            android:layout_width="@dimen/lang_icon_width"
            android:layout_height="@dimen/lang_icon_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/lang_btn_height"
            android:fontFamily="@font/roboto_bold"
            android:paddingStart="0dp"
            android:layout_marginStart="@dimen/margin_title_image_bet_warning_start"
            android:layout_marginEnd="@dimen/margin_horizontal_item_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/next_icon"
            app:layout_constraintStart_toEndOf="@+id/lang_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/SettingLanguageButtonTitle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/next_icon"
            android:layout_width="@dimen/next_icon_height"
            android:layout_height="@dimen/next_icon_height"
            android:src="@drawable/ic_right_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
