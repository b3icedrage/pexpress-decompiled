<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivationBlockRootContainer.StepDescription">
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/activation_step_description_illustration"
        android:layout_width="@dimen/activation_step_description_illustration_size"
        android:layout_height="@dimen/activation_step_description_illustration_size"
        android:layout_marginTop="@dimen/activation_step_description_illustration_margin_top"
        android:scaleType="centerInside"/>
    <TextView
        android:id="@+id/activation_step_description_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activation_step_description_part_margin_horizontal"
        android:layout_marginTop="@dimen/activation_step_description_title_margin_top"
        android:layout_marginRight="@dimen/activation_step_description_part_margin_horizontal"
        android:layout_marginHorizontal="@dimen/activation_step_description_part_margin_horizontal"
        style="@style/ActivationStepDescriptionTitle"/>
    <TextView
        android:id="@+id/activation_step_description_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activation_step_description_part_margin_horizontal"
        android:layout_marginTop="@dimen/activation_step_description_description_margin_top"
        android:layout_marginRight="@dimen/activation_step_description_part_margin_horizontal"
        android:layout_marginBottom="@dimen/activation_step_description_description_margin_bottom"
        android:layout_marginHorizontal="@dimen/activation_step_description_part_margin_horizontal"
        style="@style/ActivationStepDescriptionDescription"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="@dimen/activation_step_description_part_bottom_space_height"/>
</LinearLayout>
