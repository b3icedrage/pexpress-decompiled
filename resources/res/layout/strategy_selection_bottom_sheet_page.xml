<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center"
        android:id="@+id/strategy_selection_illustration"
        android:layout_width="@dimen/strategy_selection_illustration_width"
        android:layout_height="@dimen/strategy_selection_illustration_width"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:scaleType="center"
        android:layout_marginStart="@dimen/common_outer_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/strategy_selection_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toTopOf="@+id/strategy_selection_risk_label"
        app:layout_constraintStart_toEndOf="@+id/strategy_selection_illustration"
        app:layout_constraintTop_toTopOf="@+id/strategy_selection_illustration"
        style="@style/RobotStrategyTitle"/>
    <ImageView
        android:id="@+id/strategy_selection_lock_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_lock_24"
        app:layout_constraintStart_toEndOf="@+id/strategy_selection_title"
        app:layout_constraintTop_toTopOf="@+id/strategy_selection_title"/>
    <ImageView
        android:id="@+id/strategy_selection_risk_icon"
        android:layout_width="@dimen/strategy_selection_risk_icon_size"
        android:layout_height="@dimen/strategy_selection_risk_icon_size"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/strategy_selection_risk_label_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/strategy_selection_risk_label"
        app:layout_constraintEnd_toStartOf="@+id/strategy_selection_risk_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/strategy_selection_title"
        app:layout_constraintTop_toTopOf="@+id/strategy_selection_risk_label"/>
    <TextView
        android:id="@+id/strategy_selection_risk_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/strategy_selection_risk_label_margin_top"
        app:layout_constraintBottom_toBottomOf="@+id/strategy_selection_illustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/strategy_selection_risk_icon"
        app:layout_constraintTop_toBottomOf="@+id/strategy_selection_title"
        app:layout_constraintVertical_bias="0"
        style="@style/RobotStrategyRiskLevelText"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/strategy_selection_page_illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/profit_limit_with_activation_dialog_title_margin_top"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:scaleType="centerCrop"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintDimensionRatio="328:180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/strategy_selection_illustration"
        app:shapeAppearanceOverlay="@style/RobotStrategyIllustrationShape"/>
    <TextView
        android:id="@+id/strategy_selection_page_lower_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_big_medium"
        app:layout_constraintEnd_toEndOf="@+id/strategy_selection_page_description"
        app:layout_constraintStart_toStartOf="@+id/strategy_selection_page_description"
        app:layout_constraintTop_toBottomOf="@+id/strategy_selection_page_illustration"
        app:layout_constraintVertical_bias="0"
        style="@style/StrategySelectionPageDescription"/>
    <TextView
        android:id="@+id/strategy_selection_page_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_medium"
        android:layout_marginBottom="@dimen/margin_big"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/strategy_selection_page_illustration"
        app:layout_constraintStart_toStartOf="@+id/strategy_selection_page_illustration"
        app:layout_constraintTop_toBottomOf="@+id/strategy_selection_page_lower_description"
        style="@style/StrategySelectionPageDescription"/>
</androidx.constraintlayout.widget.ConstraintLayout>
