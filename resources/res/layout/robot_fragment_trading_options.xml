<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trading_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotTradingOptionsRootContainer">
    <View
        android:id="@+id/tutorial_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_value_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/trading_help_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_question_icon"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/title_margin_top"
        android:text="@string/main_option_title"
        android:layout_marginStart="@dimen/title_margin_start"
        android:layout_marginEnd="@dimen/title_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/trading_help_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotTradingOptionsTitle"/>
    <TextView
        android:id="@+id/amount_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/trading_values_container_margin_top"
        android:text="@string/main_robot_amount_title"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/margin_between_amount_time"
        android:labelFor="@+id/amount_value_edit_text"
        app:layout_constraintEnd_toStartOf="@+id/time_title"
        app:layout_constraintHorizontal_weight="0.61"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/RobotCommonSubsectionTitle"/>
    <TextView
        android:id="@+id/time_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bot_settings_trading_time"
        android:layout_marginEnd="@dimen/trading_values_container_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.39"
        app:layout_constraintStart_toEndOf="@+id/amount_title"
        app:layout_constraintTop_toTopOf="@+id/amount_title"
        style="@style/RobotCommonSubsectionTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/amount_value_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/amount_height"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/amount_title"
        app:layout_constraintStart_toStartOf="@+id/amount_title"
        app:layout_constraintTop_toBottomOf="@+id/amount_title"
        style="@style/RobotMaterialCardView.Amount">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/amount_currency_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/common_outer_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotEditText.Amount"/>
            <EditText
                android:id="@+id/amount_value_edit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/maximum_profit_value_value_margin_start"
                android:layout_marginEnd="@dimen/common_outer_margin"
                android:importantForAutofill="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/amount_currency_sign"
                style="@style/RobotEditText.Amount"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/time_value_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/amount_value_container"
        app:layout_constraintEnd_toEndOf="@+id/time_title"
        app:layout_constraintStart_toStartOf="@+id/time_title"
        app:layout_constraintTop_toTopOf="@+id/amount_value_container"
        style="@style/RobotMaterialCardView.Time">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer">
            <TextView
                android:id="@+id/time_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/asset_percents_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/time_icon_next"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/time_icon_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
