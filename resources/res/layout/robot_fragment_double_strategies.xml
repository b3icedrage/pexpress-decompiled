<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trading_strategies"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotFragmentPartBlockContainer">
    <TextView
        android:id="@+id/trading_strategies_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/trading_strategies_title_margin_top"
        android:text="@string/risk_management_title"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/trading_strategies_title_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/trading_strategies_help_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotStrategiesSelectionTitle"/>
    <ImageView
        android:id="@+id/trading_strategies_help_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_question_icon"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/trading_strategies_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/trading_strategies_title"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/robot_strategies_buttons_margin_top"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:baselineAligned="false"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trading_strategies_title"
        style="@style/RobotStrategiesButtonContainer">
        <include
            android:id="@+id/optimal_strategy_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/optimal_strategy_card_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/aggressive_strategy_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trading_strategies_title"
            layout="@layout/robot_fragment_trading_strategies_button"/>
        <include
            android:id="@+id/aggressive_strategy_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/aggressive_strategy_card_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/optimal_strategy_card"
            app:layout_constraintTop_toTopOf="@+id/optimal_strategy_card"
            layout="@layout/robot_fragment_trading_strategies_button"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
