<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/image_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/button_margin"
        android:layout_marginEnd="@dimen/button_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BottomSheetDialogCardView">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BottomSheetDialogImageView"/>
        <TextView
            android:id="@+id/counter"
            android:layout_width="@dimen/counter_item_size"
            android:layout_height="@dimen/counter_item_size"
            android:layout_margin="@dimen/button_margin"
            style="@style/ItemCounterViewPager"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_title"
        android:layout_marginStart="@dimen/button_margin"
        android:layout_marginEnd="@dimen/button_margin"
        app:layout_constraintTop_toBottomOf="@+id/image_card"
        style="@style/ItemTitleViewPager"/>
    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_description"
        android:layout_marginStart="@dimen/button_margin"
        android:layout_marginEnd="@dimen/button_margin"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/ItemDescriptionViewPager"/>
</androidx.constraintlayout.widget.ConstraintLayout>
