<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/accountBlockBackground"
    android:paddingBottom="@dimen/account_main_info_part_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/account_main_info_header_clickable_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="@dimen/account_main_info_part_clickable_area_elevation"
        app:layout_constraintBottom_toBottomOf="@+id/account_main_info_id_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClickableArea"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/account_main_info_avatar_image"
        android:layout_width="@dimen/account_main_info_avatar_size"
        android:layout_height="@dimen/account_main_info_avatar_size"
        android:layout_marginTop="@dimen/account_main_info_avatar_image_margin_top"
        android:layout_marginBottom="@dimen/account_main_info_avatar_image_margin_bottom"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/account_main_info_avatar_image_margin_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/AccountMainInfoAvatarImageShape"/>
    <ImageView
        android:id="@+id/account_main_info_indicator_icon"
        android:layout_width="@dimen/account_main_info_indicator_icon_size"
        android:layout_height="@dimen/account_main_info_indicator_icon_size"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/account_main_info_avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/account_main_info_avatar_image"/>
    <TextView
        android:gravity="start"
        android:id="@+id/account_main_info_nickname_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/account_main_info_nickname_text_margin_start"
        android:layout_marginEnd="@dimen/margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/account_main_info_avatar_image"
        app:layout_constraintTop_toTopOf="@+id/account_main_info_avatar_image"
        style="@style/NicknameTitle"/>
    <TextView
        android:id="@+id/account_main_info_id_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_id"
        android:layout_marginStart="@dimen/account_main_info_id_text_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/account_main_info_avatar_image"
        app:layout_constraintStart_toEndOf="@+id/account_main_info_avatar_image"
        style="@style/AccountIdText"/>
    <TextView
        android:id="@+id/account_main_info_id_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/account_main_info_id_value_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/account_main_info_id_text"
        app:layout_constraintStart_toEndOf="@+id/account_main_info_id_text"
        app:layout_constraintTop_toTopOf="@+id/account_main_info_id_text"
        style="@style/AccountIdValue"/>
    <include
        android:id="@+id/account_main_info_activation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin"
        android:layout_marginTop="@dimen/account_main_info_activation_margin_top"
        android:layout_marginRight="@dimen/margin"
        android:layout_marginHorizontal="@dimen/margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_main_info_id_value"
        layout="@layout/main_info_activation_step"/>
</androidx.constraintlayout.widget.ConstraintLayout>
