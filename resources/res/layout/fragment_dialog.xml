<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/FullScreenDialogRootContainer.TransparentBG">
    <ImageView
        android:id="@+id/close_icon"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/textGrey"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_title_container_margin_horizontal"
        android:layout_marginRight="@dimen/dialog_title_container_margin_horizontal"
        android:layout_marginHorizontal="@dimen/dialog_title_container_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/button_view"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/alert_icon_size"
            android:layout_height="@dimen/alert_icon_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DialogIcon"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_title_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            style="@style/DialogTitle"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_sutitle_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/DialogSubtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/button_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_btn_fragment_bottom"
        android:layout_marginStart="@dimen/margin_btn_fragment_horizontal"
        android:layout_marginEnd="@dimen/margin_btn_fragment_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/FullScreenDialogButtonsContainer">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/passive_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/DialogPassiveButton"/>
        <Space
            android:id="@+id/spacer"
            android:layout_width="@dimen/space_between_btn"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/active_btn_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/active_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/DialogActiveButton"/>
            <com.github.ybq.android.spinkit.SpinKitView
                android:layout_gravity="center"
                android:id="@+id/progress_circular"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/active_btn"
                style="@style/DialogSpinKitViewInButton"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
