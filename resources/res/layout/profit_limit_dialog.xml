<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BottomSheetDialogRootContainer">
    <ImageView
        android:id="@+id/profit_limit_dialog_bet_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_close_view"
        android:src="@drawable/ic_bet_warning_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/profit_limit_dialog_cup"
        android:layout_width="@dimen/profit_limit_dialog_cup_size"
        android:layout_height="@dimen/profit_limit_dialog_cup_size"
        android:layout_marginTop="@dimen/profit_limit_dialog_cup_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_dialog_bet_warning"/>
    <TextView
        android:id="@+id/profit_limit_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/profit_limit_dialog_title_margin_top"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_dialog_cup"
        style="@style/ProfitLimitDialogTitle"/>
    <TextView
        android:id="@+id/profit_limit_dialog_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profit_limit_dialog_description_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/profit_limit_dialog_title"
        app:layout_constraintStart_toStartOf="@+id/profit_limit_dialog_title"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_dialog_title"
        style="@style/ProfitLimitDialogDescription"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profit_limit_dialog_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/profit_limit_dialog_button_margin_top"
        android:layout_marginBottom="@dimen/profit_limit_dialog_button_margin_bottom"
        android:text="@string/complete_trading_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/profit_limit_dialog_title"
        app:layout_constraintStart_toStartOf="@+id/profit_limit_dialog_title"
        app:layout_constraintTop_toBottomOf="@+id/profit_limit_dialog_description"
        style="@style/ProfitLimitDialogButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
