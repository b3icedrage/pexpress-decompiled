<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/re_registration_frame_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ReRegistrationRootContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/re_registration_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/re_registration_app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.api.resources.CenteredToolbar
                android:id="@+id/re_registration_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/registration"
                style="@style/ActivationCenteredToolbar"/>
        </com.google.android.material.appbar.AppBarLayout>
        <View
            android:id="@+id/re_registration_blocking_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="@dimen/common_blocking_view_elevation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/re_registration_app_bar_layout"
            style="@style/BlockingView"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/re_registration_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/re_registration_title_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/re_registration_app_bar_layout"
            style="@style/ReRegistrationTitle"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/re_registration_email_input_layout_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/re_registration_title"
            style="@style/ActivationEmailTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/activation_register_text_input_height"
                style="@style/ActivationEmailEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <include
            android:id="@+id/activation_email_error_label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_hint_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/emailTextInputLayout"
            app:layout_constraintStart_toStartOf="@+id/emailTextInputLayout"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            layout="@layout/input_error_label"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginTop="@dimen/re_registration_password_input_layout_margin_top"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTextInputLayout"
            style="@style/ActivationPasswordInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/activation_register_text_input_height"
                style="@style/ActivationPasswordEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <include
            android:id="@+id/activation_password_error_label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/registration_hint_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/emailTextInputLayout"
            app:layout_constraintStart_toStartOf="@+id/emailTextInputLayout"
            app:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout"
            layout="@layout/input_error_label"/>
        <com.api.resources.IndicatorRadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/radio_group"
            android:layout_width="0dp"
            android:layout_height="@dimen/registration_height_currency"
            android:layout_marginLeft="@dimen/registration_margin_currency_horizontal"
            android:layout_marginTop="@dimen/registration_margin_currency_top"
            android:layout_marginRight="@dimen/registration_margin_currency_horizontal"
            android:layout_marginHorizontal="@dimen/registration_margin_currency_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/passwordTextInputLayout">
            <com.api.resources.RadioIndicatorButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/registration_margin_currency"
                android:layout_marginRight="@dimen/registration_margin_currency"
                android:text="@string/usd"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
            <com.api.resources.RadioIndicatorButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/registration_margin_currency"
                android:layout_marginRight="@dimen/registration_margin_currency"
                android:text="@string/eur"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
            <com.api.resources.RadioIndicatorButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/registration_margin_currency"
                android:layout_marginRight="@dimen/registration_margin_currency"
                android:text="@string/gbp"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
            <com.api.resources.RadioIndicatorButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/registration_margin_currency"
                android:layout_marginRight="@dimen/registration_margin_currency"
                android:text="@string/gbp"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/registration_margin_currency"/>
        </com.api.resources.IndicatorRadioGroup>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/licenceCheckBox"
            android:layout_width="@dimen/registration_licence_checkbox_width"
            android:layout_height="@dimen/registration_licence_checkbox_height"
            android:layout_marginTop="@dimen/license_check_box_margin_top"
            android:layout_marginStart="@dimen/license_check_box_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radio_group"
            style="@style/ActivationCheckBox"/>
        <TextView
            android:id="@+id/registrationAgreementText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/registration_agreement_text_margin_start"
            android:layout_marginRight="@dimen/registration_agreement_text_margin_start"
            android:layout_marginHorizontal="@dimen/registration_agreement_text_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/licenceCheckBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/licenceCheckBox"
            app:layout_constraintTop_toTopOf="@+id/licenceCheckBox"
            style="@style/ActivationAgreement"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/re_registration_registration_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginBottom="@dimen/re_registration_registration_button_margin_bottom"
            android:text="@string/create_new_account_button"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ReRegistrationRegistrationButton"/>
        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/re_registration_loading_spin_kit_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/re_registration_registration_button"
            app:layout_constraintEnd_toEndOf="@+id/re_registration_registration_button"
            app:layout_constraintStart_toStartOf="@+id/re_registration_registration_button"
            app:layout_constraintTop_toTopOf="@+id/re_registration_registration_button"
            style="@style/ReRegistrationSpinKitView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
