<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotBottomSheetRootContainer">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bottom_sheet_with_recycler_close_icon"
            android:padding="@dimen/bottom_sheet_with_recycler_close_icon_padding"
            android:layout_width="@dimen/bottom_sheet_with_recycler_close_icon_size"
            android:layout_height="@dimen/bottom_sheet_with_recycler_close_icon_size"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_with_recycler_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_sheet_with_recycler_title"/>
        <TextView
            android:id="@+id/bottom_sheet_with_recycler_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bottom_sheet_with_recycler_title_margin_horizontal"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginRight="@dimen/bottom_sheet_with_recycler_title_margin_horizontal"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/bottom_sheet_with_recycler_title_margin_horizontal"
            android:layout_marginVertical="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/bottom_sheet_with_recycler_recycler"
            app:layout_constraintEnd_toStartOf="@+id/bottom_sheet_with_recycler_help_icon"
            app:layout_constraintStart_toEndOf="@+id/bottom_sheet_with_recycler_close_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BottomSheetWithRecyclerTitle"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bottom_sheet_with_recycler_help_icon"
            android:padding="@dimen/bottom_sheet_with_recycler_help_icon_padding"
            android:layout_width="@dimen/bottom_sheet_with_recycler_help_icon_size"
            android:layout_height="@dimen/bottom_sheet_with_recycler_help_icon_size"
            android:src="@drawable/ic_question_icon"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_with_recycler_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_sheet_with_recycler_title"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bottom_sheet_with_recycler_recycler"
        android:paddingBottom="@dimen/bottom_sheet_with_recycler_recycler_padding_bottom"
        android:saveEnabled="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/bottom_sheet_with_recycler_recycler_margin_top"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_sheet_with_recycler_title"/>
</LinearLayout>
