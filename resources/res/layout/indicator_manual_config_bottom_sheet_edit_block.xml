<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_medium"
    style="@style/IndicatorEditBlockBottomCard">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/indicator_manual_config_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_outer_margin"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginRight="@dimen/common_outer_margin"
            android:layout_marginHorizontal="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/indicator_manual_config_fields"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/indicator_manual_config_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outlined_button_padding_vertical"
                android:layout_marginBottom="@dimen/outlined_button_padding_vertical"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/common_outer_margin"
                android:layout_marginVertical="@dimen/outlined_button_padding_vertical"
                style="@style/Body.Medium"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/indicator_manual_config_color"
                android:layout_width="@dimen/common_outer_margin"
                android:layout_height="@dimen/common_outer_margin"
                android:src="@drawable/ic_coupon_cut"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/indicator_manual_config_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_outer_margin"
            android:layout_marginRight="@dimen/common_outer_margin"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_marginHorizontal="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator_manual_config_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
