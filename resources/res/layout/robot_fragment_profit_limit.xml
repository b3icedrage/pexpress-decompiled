<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/trading_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotFragmentPartBlockContainer">
    <TextView
        android:id="@+id/maximum_profit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bot_settings_limit_profit"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        android:labelFor="@+id/maximum_profit_value"
        style="@style/RobotCommonSubsectionTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/maximum_profit_value_holder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/maximum_profit_value_holder_height"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        style="@style/RobotMaterialCardView">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/maximum_profit_currency_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/common_outer_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue.ProfitLimitCurrency"/>
            <EditText
                android:id="@+id/maximum_profit_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/maximum_profit_value_value_margin_start"
                android:importantForAutofill="no"
                style="@style/RobotEditText.ProfitLimit"/>
            <View
                android:id="@+id/robot_profit_limit_card_separator"
                android:layout_width="@dimen/robot_profit_limit_vertical_separator_width"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSwitchSeparator"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="@dimen/max_profit_switch_width"
                android:layout_height="match_parent">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/single_maximum_profit_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/robot_profit_limit_card_separator"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/RobotProfitLimitMaterialSwitch"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
