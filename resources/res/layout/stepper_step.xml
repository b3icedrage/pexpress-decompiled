<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stepper_step_circle_margin_top">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/activation_top_steps_outer_circle"
            android:layout_width="@dimen/activation_top_steps_outer_circle_size"
            android:layout_height="@dimen/activation_top_steps_outer_circle_size"
            android:src="@drawable/ic_green_circle"
            app:tint="@color/background"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/activation_top_steps_middle_circle"
            android:visibility="gone"
            android:layout_width="@dimen/activation_top_steps_middle_circle_size"
            android:layout_height="@dimen/activation_top_steps_middle_circle_size"
            android:src="@drawable/ic_green_circle"
            app:tint="@color/primary"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/activation_top_steps_inner_circle"
            android:layout_width="@dimen/activation_top_steps_inner_circle_size"
            android:layout_height="@dimen/activation_top_steps_inner_circle_size"
            android:src="@drawable/ic_green_circle"
            app:tint="@color/surface"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/activation_top_steps_step_number"
            android:paddingBottom="@dimen/activation_top_steps_step_number_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ActivationTopStepsStep"/>
    </FrameLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/activation_top_steps_step_name"
        android:layout_width="@dimen/activation_top_steps_step_name_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activation_top_steps_step_name_margin_horizontal"
        android:layout_marginTop="@dimen/activation_top_steps_step_name_margin_top"
        android:layout_marginRight="@dimen/activation_top_steps_step_name_margin_horizontal"
        android:layout_marginBottom="@dimen/common_outer_margin"
        android:layout_marginHorizontal="@dimen/activation_top_steps_step_name_margin_horizontal"
        style="@style/ActivationTopStepsStepName"/>
</LinearLayout>
