<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/StubGameRootContainer">
    <FrameLayout
        android:id="@+id/stub_game_snackbar_anchor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/stub_game_balance_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stub_game_balance_text"/>
    <TextView
        android:id="@+id/stub_game_balance_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stub_game_balance_text_margin_top"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/StubGameBalance"/>
    <com.base.feature.stub.usecases.StubGameLineChart
        android:id="@+id/stub_game_chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/stub_game_chart_margin_top"
        android:layout_marginBottom="@dimen/stub_game_chart_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/stub_game_bet_up_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stub_game_balance_text"/>
    <TextView
        android:id="@+id/stub_game_asset_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/stub_game_eur_usd"
        android:drawablePadding="12dp"
        android:layout_marginStart="8dp"
        app:drawableStartCompat="@drawable/stub_game_eur_usd_icon"
        app:layout_constraintStart_toStartOf="@+id/stub_game_chart"
        app:layout_constraintTop_toTopOf="@+id/stub_game_chart"
        style="@style/StubGameAsset"/>
    <com.google.android.material.button.MaterialButton
        android:gravity="start"
        android:id="@+id/stub_game_bet_up_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/common_outer_margin"
        android:text="@string/btn_up"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/stub_game_bet_up_buttons_margin_between"
        app:icon="@drawable/stub_game_arrow_up"
        app:iconGravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stub_game_bet_down_button"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StubGameBetButton.Up"/>
    <com.google.android.material.button.MaterialButton
        android:gravity="start"
        android:id="@+id/stub_game_bet_down_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/btn_down"
        android:layout_marginStart="@dimen/stub_game_bet_up_buttons_margin_between"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:icon="@drawable/stub_game_arrow_down"
        app:iconGravity="end"
        app:layout_constraintBottom_toBottomOf="@+id/stub_game_bet_up_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stub_game_bet_up_button"
        app:layout_constraintTop_toTopOf="@+id/stub_game_bet_up_button"
        style="@style/StubGameBetButton.Down"/>
</androidx.constraintlayout.widget.ConstraintLayout>
