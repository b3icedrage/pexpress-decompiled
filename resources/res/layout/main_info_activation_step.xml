<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/AccountMainInfoActivationContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/main_info_activation_step_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:text="@string/activation_account_text"
            android:layout_marginStart="@dimen/margin"
            app:layout_constraintEnd_toEndOf="@+id/main_info_activation_step_action_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AccountMainInfoActivationTitle"/>
        <TextView
            android:id="@+id/main_info_activation_step_action_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/main_info_activation_step_action_text_margin_top"
            android:layout_marginEnd="@dimen/main_info_activation_step_action_text_margin_end"
            app:layout_constraintEnd_toStartOf="@+id/main_info_activation_step_image"
            app:layout_constraintStart_toStartOf="@+id/main_info_activation_step_title"
            app:layout_constraintTop_toBottomOf="@+id/main_info_activation_step_title"
            style="@style/AccountMainInfoActivationActionText"/>
        <ProgressBar
            android:id="@+id/main_info_activation_step_progress"
            android:layout_width="@dimen/main_info_activation_step_progress_width"
            android:layout_height="@dimen/main_info_activation_step_progress_height"
            android:layout_marginTop="@dimen/main_info_activation_step_progress_margin_top"
            android:layout_marginBottom="@dimen/main_info_activation_step_progress_margin_top"
            android:indeterminate="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/main_info_activation_step_action_text"
            app:layout_constraintTop_toBottomOf="@+id/main_info_activation_step_action_text"
            style="@style/AccountMainInfoActivationProgress"/>
        <TextView
            android:id="@+id/main_info_activation_step_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/main_info_activation_step_counter_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/main_info_activation_step_progress"
            app:layout_constraintStart_toEndOf="@+id/main_info_activation_step_progress"
            app:layout_constraintTop_toTopOf="@+id/main_info_activation_step_progress"
            style="@style/AccountMainInfoActivationCounter"/>
        <TextView
            android:id="@+id/main_info_activation_step_duration_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/main_info_activation_step_title"
            style="@style/AccountMainInfoActivationDurationText"/>
        <ImageView
            android:id="@+id/main_info_activation_step_image"
            android:layout_width="@dimen/main_info_activation_step_image_size"
            android:layout_height="@dimen/main_info_activation_step_image_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
