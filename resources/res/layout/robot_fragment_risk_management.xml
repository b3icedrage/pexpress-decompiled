<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trading_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotFragmentPartBlockContainer">
    <TextView
        android:id="@+id/maximum_profit_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bot_settings_limit_profit"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        android:labelFor="@+id/maximum_profit_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotCommonSubsectionTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/maximum_profit_value_holder"
        android:layout_width="0dp"
        android:layout_height="@dimen/maximum_profit_value_holder_height"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maximum_profit_sub_title"
        style="@style/RobotMaterialCardView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer.ProfitLimit">
            <TextView
                android:id="@+id/maximum_profit_currency_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue.ProfitLimitCurrency"/>
            <EditText
                android:id="@+id/maximum_profit_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/maximum_profit_value_margin_start"
                android:importantForAutofill="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/robot_profit_limit_card_separator"
                app:layout_constraintStart_toEndOf="@+id/maximum_profit_currency_value"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotEditText.ProfitLimit"/>
            <View
                android:id="@+id/robot_profit_limit_card_separator"
                android:layout_width="@dimen/robot_profit_limit_vertical_separator_width"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/robot_profit_limit_card_separator_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSwitchSeparator"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/maximum_profit_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/robot_profit_limit_card_separator"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotProfitLimitMaterialSwitch"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/profit_limit_shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer.ProfitLimit">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/profit_limit_shimmer_start_text"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/common_outer_margin"
                app:srcCompat="@drawable/profit_limit_shimmer_end_switch"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/profit_limit_not_activated_blocking_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/maximum_profit_value_holder"
        app:layout_constraintEnd_toEndOf="@+id/maximum_profit_value_holder"
        app:layout_constraintStart_toStartOf="@+id/maximum_profit_value_holder"
        app:layout_constraintTop_toTopOf="@+id/maximum_profit_value_holder"
        style="@style/ProfitLimitNotActivatedBlockingView"/>
    <TextView
        android:id="@+id/maximum_profit_bottom_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:text="@string/bonus_label"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maximum_profit_value_holder"
        style="@style/RobotCommonBottomSubsectionTitle"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/profit_limit_shimmer_bottom_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maximum_profit_value_holder">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/profit_limit_shimmer_bottom_text"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <TextView
        android:id="@+id/loss_limit_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_between_signals_and_limit"
        android:text="@string/bot_settings_limit_loss_title"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        android:labelFor="@+id/loss_limit_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/maximum_profit_bottom_sub_title"
        style="@style/RobotCommonSubsectionTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loss_limit_value_holder"
        android:layout_width="0dp"
        android:layout_height="@dimen/maximum_profit_value_holder_height"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loss_limit_sub_title"
        style="@style/RobotMaterialCardView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/RobotValueContainer.ProfitLimit">
            <TextView
                android:id="@+id/loss_limit_currency_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotValue.ProfitLimitCurrency"/>
            <EditText
                android:id="@+id/loss_limit_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/maximum_profit_value_margin_start"
                android:importantForAutofill="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/robot_loss_limit_card_separator"
                app:layout_constraintStart_toEndOf="@+id/loss_limit_currency_value"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotEditText.ProfitLimit"/>
            <View
                android:id="@+id/robot_loss_limit_card_separator"
                android:layout_width="@dimen/robot_profit_limit_vertical_separator_width"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/robot_profit_limit_card_separator_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSwitchSeparator"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/loss_limit_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/robot_loss_limit_card_separator"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotProfitLimitMaterialSwitch"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/loss_limit_not_activated_blocking_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/loss_limit_value_holder"
        app:layout_constraintEnd_toEndOf="@+id/loss_limit_value_holder"
        app:layout_constraintStart_toStartOf="@+id/loss_limit_value_holder"
        app:layout_constraintTop_toTopOf="@+id/loss_limit_value_holder"
        style="@style/ProfitLimitNotActivatedBlockingView"/>
    <TextView
        android:id="@+id/loss_limit_bottom_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/robot_common_value_container_margin_top"
        android:text="@string/bonus_label"
        android:layout_marginStart="@dimen/common_outer_margin"
        android:layout_marginEnd="@dimen/common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loss_limit_value_holder"
        style="@style/RobotCommonBottomSubsectionTitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/loss_limit_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="loss_limit_bottom_sub_title,loss_limit_not_activated_blocking_view,loss_limit_value_holder,loss_limit_sub_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
