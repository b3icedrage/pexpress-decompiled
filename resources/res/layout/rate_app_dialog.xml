<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/DialogRootContainer">
    <ImageView
        android:id="@+id/close_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/common_outer_margin"
        android:layout_marginTop="@dimen/rate_app_dialog_margin_top"
        android:src="@drawable/ic_close_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rate_app_dialog_margin_top"
        android:src="@drawable/ic_rate_app_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DialogIcon"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
        android:text="@string/rate_us_title"
        android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        style="@style/DialogTitle"/>
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
        android:layout_marginTop="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
        android:text="@string/rate_us_description"
        android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/DialogSubtitle"/>
    <com.base.feature.alertdialog.screen.StarViewGroup
        android:id="@+id/star_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
        android:layout_marginTop="@dimen/rate_app_dialog_button_margin_vertical"
        android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
        android:layout_marginBottom="@dimen/rate_app_dialog_button_margin_vertical"
        android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
        android:layout_marginVertical="@dimen/rate_app_dialog_button_margin_vertical"
        app:layout_constraintBottom_toTopOf="@+id/active_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <Button
        android:id="@+id/active_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
        android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
        android:layout_marginBottom="@dimen/rate_app_dialog_button_margin_vertical"
        android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/star_container"
        style="@style/DialogActiveButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
