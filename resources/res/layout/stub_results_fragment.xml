<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/StubResultsRootContainer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/stub_results_learn_more_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.74">
        <ImageView
            android:id="@+id/stub_results_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/stub_results_image_margin_bottom"
            app:layout_constraintBottom_toTopOf="@+id/stub_results_title_text"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="@+id/stub_results_title_text"
            app:layout_constraintStart_toStartOf="@+id/stub_results_title_text"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StubResultsOuterImage"/>
        <TextView
            android:id="@+id/stub_results_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginBottom="@dimen/stub_results_title_text_margin_bottom"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintBottom_toTopOf="@+id/stub_results_subtitle_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/StubResultsTitle"/>
        <TextView
            android:id="@+id/stub_results_subtitle_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_margin_horizontal"
            android:layout_marginRight="@dimen/common_margin_horizontal"
            android:layout_marginBottom="@dimen/stub_results_subtitle_text_margin_bottom"
            android:layout_marginHorizontal="@dimen/common_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/StubResultsSubtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stub_results_learn_more_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/stub_results_button_margin_bottom"
        android:text="@string/btn_learn_how"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toTopOf="@+id/stub_results_try_again_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StubResultsButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stub_results_try_again_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/stub_results_button_margin_bottom"
        android:text="@string/try_again_text"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StubResultsActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
