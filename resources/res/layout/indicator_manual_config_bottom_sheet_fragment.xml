<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BottomSheetDialogRootContainer">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/indicator_manual_config_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/bottom_sheet_with_recycler_close_icon_size"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bottom_sheet_with_recycler_close_icon"
            android:padding="@dimen/bottom_sheet_with_recycler_close_icon_padding"
            android:layout_width="@dimen/bottom_sheet_with_recycler_close_icon_size"
            android:layout_height="@dimen/bottom_sheet_with_recycler_close_icon_size"
            android:src="@drawable/ic_right_arrow"
            android:scaleX="-1"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_with_recycler_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_sheet_with_recycler_title"/>
        <TextView
            android:id="@+id/bottom_sheet_with_recycler_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/bottom_sheet_with_recycler_recycler"
            app:layout_constraintEnd_toStartOf="@+id/bottom_sheet_with_recycler_help_icon"
            app:layout_constraintStart_toEndOf="@+id/bottom_sheet_with_recycler_close_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BottomSheetWithRecyclerTitle"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/indicators_manual_config_recycler"
        android:saveEnabled="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/common_outer_margin"
        android:layout_marginRight="@dimen/common_outer_margin"
        android:layout_marginBottom="@dimen/common_outer_margin"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/common_outer_margin"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/indicator_manual_config_reset_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/common_outer_margin"
            android:text="@string/btn_reset"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/common_outer_margin"
            style="@style/CustomActionButton.Large.Grey"/>
        <View
            android:id="@+id/manual_config_spacer"
            android:layout_width="@dimen/margin_small_medium"
            android:layout_height="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/indicator_manual_config_save_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/common_outer_margin"
            style="@style/CustomActionButton.Large"/>
    </LinearLayout>
</LinearLayout>
