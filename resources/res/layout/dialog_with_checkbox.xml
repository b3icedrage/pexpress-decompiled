<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/DialogRootContainer">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_icon_alert_top"
        android:layout_marginStart="@dimen/dialog_common_outer_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DialogIcon"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dialog_common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        style="@style/DialogTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="title, icon"/>
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_common_outer_margin"
        android:layout_marginTop="@dimen/margin_subtitle_top_with_checkbox"
        android:layout_marginRight="@dimen/dialog_common_outer_margin"
        android:text="@string/please_wait_text"
        android:layout_marginHorizontal="@dimen/dialog_common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"
        style="@style/DialogSubtitle"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox"
        android:layout_width="0dp"
        android:layout_height="@dimen/checkbox_height"
        android:layout_marginTop="@dimen/margin_btn_alert_top"
        android:layout_marginBottom="@dimen/margin_btn_alert_bottom"
        android:layout_marginStart="@dimen/dialog_common_outer_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        style="@style/DialogCheckBox"/>
    <TextView
        android:id="@+id/checkbox_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_alert_horizontal_checkbox"
        android:layout_marginEnd="@dimen/dialog_common_outer_margin"
        app:layout_constraintBottom_toBottomOf="@+id/checkbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkbox"
        app:layout_constraintTop_toTopOf="@+id/checkbox"
        style="@style/DialogCheckBoxCheckBoxText"/>
    <LinearLayout
        android:id="@+id/button_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
        android:layout_marginTop="@dimen/dialog_common_button_container_margin_top"
        android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
        android:layout_marginBottom="@dimen/dialog_common_button_container_margin_bottom"
        android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox"
        app:layout_constraintVertical_bias="0"
        style="@style/DialogButtonsContainer">
        <Button
            android:id="@+id/passive_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/alert_button_horizontal_padding"
            android:paddingEnd="@dimen/alert_button_horizontal_padding"
            style="@style/DialogPassiveButton"/>
        <Space
            android:id="@+id/spacer"
            android:layout_width="@dimen/space_between_btn"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/active_btn_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:id="@+id/active_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/DialogActiveButton"/>
            <com.github.ybq.android.spinkit.SpinKitView
                android:layout_gravity="center"
                android:id="@+id/progress_circular"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/DialogSpinKitViewInButton"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/disclaimer_separator"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_divider_recycler_language"
        android:layout_marginLeft="@dimen/dialog_common_outer_margin"
        android:layout_marginRight="@dimen/dialog_common_outer_margin"
        android:layout_marginHorizontal="@dimen/dialog_common_outer_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_view"
        style="@style/DialogSeparator"/>
    <TextView
        android:id="@+id/disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/disclaimer_margin_vertical"
        android:layout_marginBottom="@dimen/disclaimer_margin_vertical"
        android:layout_marginStart="@dimen/margin_alert_horizontal"
        android:layout_marginEnd="@dimen/margin_alert_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer_separator"
        style="@style/DialogSubSubtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
