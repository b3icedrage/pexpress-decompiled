<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_bet_warning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/collapse_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_close_view"
        android:src="@drawable/ic_bet_warning_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/title_image"
        android:padding="@dimen/padding_title_image_bet_warning"
        android:layout_width="@dimen/size_image_bet_warning"
        android:layout_height="@dimen/size_image_bet_warning"
        android:layout_marginTop="@dimen/stop_warning_title_image_top"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/collapse_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stop_warning_title_text_top"
        android:layout_marginStart="@dimen/stop_warning_title_text_start"
        android:layout_marginEnd="@dimen/stop_warning_title_text_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_image"
        style="@style/BetWarningTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/one_click_stop_view_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/btn_stop_warning_margin_between_switch_title"
        android:layout_marginBottom="@dimen/btn_bet_warning_margin"
        android:layout_marginStart="@dimen/btn_bet_warning_margin"
        android:layout_marginEnd="@dimen/btn_bet_warning_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"
        style="@style/StopWarningValueContainerMaterialCardView">
        <include
            android:id="@+id/one_click_stop_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/bet_warning_switch_item"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/btn_bet_warning_margin_top"
        android:layout_marginBottom="@dimen/btn_bet_warning_margin_bottom"
        android:text="@string/cancel_text"
        android:layout_marginStart="@dimen/btn_bet_warning_margin"
        android:layout_marginEnd="@dimen/btn_stop_warning_margin_between_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/confirm_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/one_click_stop_view_container"
        style="@style/StopWarningCancelButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/confirm_text"
        android:layout_marginStart="@dimen/btn_stop_warning_margin_between_btn"
        android:layout_marginEnd="@dimen/btn_bet_warning_margin"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancel_button"
        app:layout_constraintTop_toTopOf="@+id/cancel_button"
        style="@style/StopWarningConfirmButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
