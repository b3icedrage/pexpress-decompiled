<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/VpnInstructionItemRootContainer">
    <TextView
        android:id="@+id/number_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vpn_number_background_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VpnInstructionStepItem"/>
    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vpn_item_description_margin_horizontal"
        android:layout_marginTop="@dimen/vpn_item_description_margin_top"
        android:layout_marginRight="@dimen/vpn_item_description_margin_horizontal"
        android:layout_marginHorizontal="@dimen/vpn_item_description_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/number_text"
        style="@style/VpnInstructionTitle"/>
    <com.github.ybq.android.spinkit.SpinKitView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/vpn_instruction_item_image"
        app:layout_constraintEnd_toEndOf="@+id/vpn_instruction_item_image"
        app:layout_constraintStart_toStartOf="@+id/vpn_instruction_item_image"
        app:layout_constraintTop_toTopOf="@+id/vpn_instruction_item_image"
        style="@style/VpnInstructionItemSpinKitView"/>
    <ImageView
        android:id="@+id/vpn_instruction_item_image"
        android:paddingBottom="@dimen/vpn_image_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vpn_image_margin_top"
        android:layout_marginStart="@dimen/vpn_image_horizontal_margin"
        android:layout_marginEnd="@dimen/vpn_image_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        style="@style/VpnInstructionItemImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
