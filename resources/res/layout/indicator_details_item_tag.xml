<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/description_top_margin"
    app:cardBackgroundColor="@color/transparent">
    <TextView
        android:id="@+id/step_description_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/text_top_margin"
        android:layout_marginBottom="@dimen/text_top_margin"
        android:layout_marginStart="@dimen/text_start_margin"
        android:layout_marginEnd="@dimen/text_end_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CustomSubhead.Medium.Grey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
