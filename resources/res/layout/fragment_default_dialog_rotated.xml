<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.rongi.rotate_layout.layout.RotateLayout
        android:id="@+id/rotatableAppBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:angle="270"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="10:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/DialogRootContainer">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_icon_alert_top"
                app:layout_constraintBottom_toTopOf="@+id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/DialogIcon"/>
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dialog_common_outer_margin"
                android:layout_marginTop="@dimen/dialog_default_horizontal_title_margin_top"
                android:layout_marginRight="@dimen/dialog_common_outer_margin"
                android:layout_marginHorizontal="@dimen/dialog_common_outer_margin"
                app:layout_constraintBottom_toTopOf="@+id/subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icon"
                style="@style/DialogTitle.Horizontal"/>
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_default_horizontal_subtitle_margin_top"
                app:layout_constraintBottom_toTopOf="@+id/button_view"
                app:layout_constraintEnd_toEndOf="@+id/title"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/DialogSubtitle.Horizontal"/>
            <LinearLayout
                android:id="@+id/button_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dialog_common_button_outer_margin"
                android:layout_marginTop="@dimen/default_dialog_horizontal_button_container_margin_vertical"
                android:layout_marginRight="@dimen/dialog_common_button_outer_margin"
                android:layout_marginBottom="@dimen/default_dialog_button_container_margin_vertical"
                android:layout_marginHorizontal="@dimen/dialog_common_button_outer_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"
                style="@style/DialogButtonsContainer">
                <Button
                    android:id="@+id/passive_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    style="@style/DialogPassiveButton"/>
                <Space
                    android:id="@+id/spacer"
                    android:layout_width="@dimen/space_between_btn"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/active_btn_layout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/active_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/DialogActiveButton"/>
                    <com.github.ybq.android.spinkit.SpinKitView
                        android:layout_gravity="center"
                        android:id="@+id/progress_circular"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/DialogSpinKitViewInButton"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.github.rongi.rotate_layout.layout.RotateLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
