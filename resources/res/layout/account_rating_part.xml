<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/accountBlockBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/common_outer_margin">
    <TextView
        android:id="@+id/account_rating_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin"
        android:layout_marginTop="@dimen/margin"
        android:layout_marginRight="@dimen/margin"
        android:text="@string/rating_title"
        android:layout_marginHorizontal="@dimen/margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AccountRatingTitle"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/account_rating_rating_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin"
        android:layout_marginTop="@dimen/margin"
        android:layout_marginRight="@dimen/margin"
        android:layout_marginBottom="@dimen/margin"
        android:layout_marginHorizontal="@dimen/margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_rating_title_text"
        style="@style/AccountRatingPlaceMaterialCardButton">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/account_rating_rating_badge_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/account_main_info_rating_badge_image_margin_vertical"
                android:layout_marginBottom="@dimen/account_main_info_rating_badge_image_margin_vertical"
                android:src="@drawable/ic_account_rating_badge_top_1"
                android:layout_marginStart="@dimen/account_main_info_rating_badge_image_margin_start"
                android:layout_marginVertical="@dimen/account_main_info_rating_badge_image_margin_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/account_rating_rating_position_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/account_main_info_rating_position_text_margin_top"
                android:layout_marginStart="@dimen/account_main_info_rating_position_text_margin_start"
                app:layout_constraintStart_toEndOf="@+id/account_rating_rating_badge_image"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RatingPlaceTitle"/>
            <TextView
                android:id="@+id/account_rating_rating_position_description_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/account_main_info_rating_position_description_text_margin_bottom"
                android:text="@string/place_in_rating_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/account_rating_rating_position_text"
                style="@style/RatingPlaceCaption"/>
            <ImageView
                android:id="@+id/account_rating_right_arrow_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/account_main_info_right_arrow_image_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_right_arrow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
