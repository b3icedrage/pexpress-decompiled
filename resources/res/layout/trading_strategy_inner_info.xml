<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/common_outer_margin"
    android:layout_marginRight="@dimen/common_outer_margin"
    android:layout_marginHorizontal="@dimen/common_outer_margin"
    style="@style/AltRobotMaterialCardView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/strategy_selection_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="center"
            android:id="@+id/strategy_selection_illustration"
            android:layout_width="@dimen/strategy_selection_illustration_width"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/common_outer_margin"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/common_outer_margin"
            app:layout_constraintBottom_toTopOf="@+id/strategy_selection_bottom_spacer"
            app:layout_constraintHeight_min="@dimen/strategy_selection_illustration_min_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/strategy_selection_bottom_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="strategy_selection_illustration, strategy_selection_show_details"/>
        <TextView
            android:id="@+id/strategy_selection_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintStart_toEndOf="@+id/strategy_selection_illustration"
            app:layout_constraintTop_toTopOf="@+id/strategy_selection_illustration"
            style="@style/RobotStrategyTitle"/>
        <ImageView
            android:id="@+id/strategy_selection_lock_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lock_24"
            app:layout_constraintStart_toEndOf="@+id/strategy_selection_title"
            app:layout_constraintTop_toTopOf="@+id/strategy_selection_title"/>
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/strategy_selection_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/strategy_selection_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/strategy_selection_title"
            style="@style/RobotStrategyRadioButton"/>
        <ImageButton
            android:id="@+id/strategy_selection_arrow_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/common_outer_margin"
            app:layout_constraintBottom_toBottomOf="@+id/strategy_selection_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/strategy_selection_title"
            style="@style/RobotStrategyArrowNextButton"/>
        <ImageView
            android:id="@+id/strategy_selection_risk_icon"
            android:layout_width="@dimen/strategy_selection_risk_icon_size"
            android:layout_height="@dimen/strategy_selection_risk_icon_size"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/strategy_selection_risk_label_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/strategy_selection_risk_label"
            app:layout_constraintEnd_toStartOf="@+id/strategy_selection_risk_label"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/strategy_selection_title"
            app:layout_constraintTop_toTopOf="@+id/strategy_selection_risk_label"/>
        <TextView
            android:id="@+id/strategy_selection_risk_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/strategy_selection_risk_label_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/strategy_selection_risk_icon"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_title"
            style="@style/RobotStrategyRiskLevelText"/>
        <TextView
            android:id="@+id/strategy_selection_recommended_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/strategy_selection_recommended_balance_margin_top"
            android:text="@string/recommended_balance_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/strategy_selection_title"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_risk_label"
            app:layout_constraintVertical_bias="0"
            style="@style/RobotStrategyDescription"/>
        <TextView
            android:id="@+id/strategy_selection_at_least"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/strategy_selection_recommended_balance"
            app:layout_constraintStart_toStartOf="@+id/strategy_selection_recommended_balance"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_recommended_balance"
            style="@style/RobotStrategyDescription"/>
        <TextView
            android:id="@+id/strategy_selection_show_details"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/strategy_show_details_margin_top"
            android:text="@string/show_details_text"
            app:layout_constraintEnd_toEndOf="@+id/strategy_selection_recommended_balance"
            app:layout_constraintStart_toStartOf="@+id/strategy_selection_recommended_balance"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_at_least"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/RobotStrategyShowDetails"/>
        <FrameLayout
            android:id="@+id/strategy_selection_show_details_frame"
            android:visibility="gone"
            android:layout_width="97dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/margin_small_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/strategy_selection_illustration"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_at_least"/>
        <View
            android:id="@+id/strategy_selection_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="@dimen/common_outer_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/strategy_selection_bottom_barrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
