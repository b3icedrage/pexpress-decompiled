<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/RobotCommonActionButtonContainer">
    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/robot_common_action_button_base"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotStartTradingBase"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/common_action_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_action_button_margin_start"
        android:layout_marginTop="@dimen/common_action_button_margin_top"
        android:layout_marginRight="@dimen/common_action_button_margin_start"
        android:layout_marginBottom="@dimen/common_action_button_margin_start"
        android:layout_marginHorizontal="@dimen/common_action_button_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotStartTradingActionButton"/>
    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/trading_loading"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/progress_in_btn_margin"
        app:layout_constraintBottom_toBottomOf="@+id/common_action_button"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/common_action_button"
        app:layout_constraintStart_toStartOf="@+id/common_action_button"
        app:layout_constraintTop_toTopOf="@+id/common_action_button"
        style="@style/RobotStartTradingSpinKitView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
