<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/accountNoConnectionLabelBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/no_connection_label_elevation">
    <ImageView
        android:id="@+id/no_connection_label_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/no_connection_label_icon_margin"
        android:src="@drawable/ic_warning"
        android:layout_marginStart="@dimen/no_connection_label_icon_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/no_connection_label_margin_vertical"
        android:layout_marginBottom="@dimen/no_connection_label_margin_vertical"
        android:text="@string/error_no_internet_description"
        android:layout_marginStart="@dimen/no_connection_label_margin_start"
        android:layout_marginEnd="@dimen/no_connection_label_margin_end"
        android:layout_marginVertical="@dimen/no_connection_label_margin_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/no_connection_label_image"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RatingNoConnectionLabel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
